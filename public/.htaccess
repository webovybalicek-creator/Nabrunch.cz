# AVIF obrázky (některé servery typ neznají)
<IfModule mod_mime.c>
  AddType image/avif .avif
</IfModule>

Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ověřování certifikátu nechat bez přesměrování
  RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
  RewriteRule ^ - [L]

  # http → https (doménu nevynucujeme, web běží na new.nabrunch.cz i nabrunch.cz)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → bez www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Data hodnocení (SQLite) nejsou veřejná
  RewriteRule ^_data(/|$) - [F,L]

  # Staré adresy z WordPressu
  RewriteRule ^nezarazene/?$ /blog/ [L,R=301]
  # Stránkování, štítky, autoři a sitemapy z WordPressu
  RewriteRule ^(.+)/page/\d+/?$ /$1/ [L,R=301]
  RewriteRule ^page/\d+/?$ / [L,R=301]
  RewriteRule ^(tag|author)/.*$ /blog/ [L,R=301]
  # /sitemaps.xml (SEOPress) je vlastní soubor se stejným obsahem jako /sitemap.xml
  RewriteRule ^(wp-sitemap|sitemap_index|[a-z_]+-sitemap\d*)\.xml$ /sitemap.xml [L,R=301]
  RewriteRule ^wp-(admin|login\.php).*$ / [L,R=302]
  RewriteRule ^category/.*$ /blog/ [L,R=301]
  RewriteRule ^(feed|comments/feed)/?$ / [L,R=301]
  RewriteRule ^domu/?$ / [L,R=301]
  # Obrázky z WordPressu → WebP verze (zachová staré odkazy a obrázky ve vyhledávání)
  RewriteRule ^wp-content/uploads/.+-\d+x\d+\.(jpe?g|png|webp|gif)$ - [S=1]
  RewriteRule ^wp-content/uploads/(.+)\.(jpe?g|png|webp|gif)$ /obrazky/$1.webp [L,R=301]
  RewriteRule ^wp-content/uploads/(.+)-\d+x\d+\.(jpe?g|png|webp|gif)$ /obrazky/$1.webp [L,R=301]
  RewriteRule ^8-food-trendu-ktere-prave-ovladaji-prazske-kavarny-a-brunch-podniky-.+$ /8-food-trendu-ktere-prave-ovladaji-prazske-kavarny-a-brunch-podniky/ [L,R=301]
  # Sloučené články (11/2026): kanibalizace stejných dotazů
  RewriteRule ^brunch-vs-snidane-tady-je-rozdil/?$ /co-je-to-brunch/ [L,R=301]
  RewriteRule ^kam-na-snidani-nebo-brunch-v-brne-2-cast/?$ /kam-na-snidani-nebo-brunch-v-brne/ [L,R=301]
  RewriteRule ^novy-matcha-spot-v-praze-jun-matcha-bar-vas-okouzli-nejen-matchou/?$ /podniky/jun-matcha-bar-praha/ [L,R=301]
  # Trvale zavřené podniky (odebrané z webu) → stránka lokality
  RewriteRule ^podniky/charlies-cafe-praha-uhrineves/?$ /lokalita/praha-10/ [L,R=301]
  # Zrušené téma (štítek měly skoro všechny podniky) → přehled podniků
  RewriteRule ^vegetarianske-snidane-a-brunche/?$ /podniky/ [L,R=301]
</IfModule>

# Interní soubory nezveřejňovat (manifest deploye, konfigurace s API klíčem)
<FilesMatch "^(\.deploy-manifest\.txt|_konfig\.php|_smtp\.php|_kavarny-kontakty\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=600, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
