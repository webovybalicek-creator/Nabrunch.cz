  RewriteRule ^kavarny/praha/kafe-francin/?$ /podniky/kafe-francin-praha/ [L,R=301]
  # Zavřené kavárny z OSM → stránka města
  RewriteRule ^kavarny/pardubice/dobry-kafe/?$ /lokalita/pardubice/ [L,R=301]
  # Zrušené téma (štítek měly skoro všechny podniky) → přehled podniků
  RewriteRule ^vegetarianske-snidane-a-brunche/?$ /podniky/ [L,R=301]
</IfModule>

# Interní soubory nezveřejňovat (manifest deploye, konfigurace s API klíčem)
<FilesMatch "^(\.deploy-manifest\.txt|_konfig\.php|_smtp\.php|_kavarny-kontakty\.php|_podniky-nazvy\.php|_clanky-seznam\.php|_github\.php|_admin-obsah\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=600, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
