# AVIF obrázky (některé servery typ neznají)
<IfModule mod_mime.c>
  AddType image/avif .avif
</IfModule>

Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ověřování certifikátu nechat bez přesměrování
  RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
  RewriteRule ^ - [L]

  # http → https (doménu nevynucujeme, web běží na new.nabrunch.cz i nabrunch.cz)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → bez www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Data správy kaváren (SQLite) nejsou veřejná
  RewriteRule ^_data(/|$) - [F,L]

  # Administrace (schvalování majitelů, úprav a fotek)
  RewriteRule ^(prihlaseni|sprava|admin)/?$ /api/admin.php [L]

  # Staré adresy z WordPressu
  RewriteRule ^nezarazene/?$ /blog/ [L,R=301]
  # Stránkování, štítky, autoři a sitemapy z WordPressu
  RewriteRule ^(.+)/page/\d+/?$ /$1/ [L,R=301]
  RewriteRule ^page/\d+/?$ / [L,R=301]
  RewriteRule ^(tag|author)/.*$ /blog/ [L,R=301]
  # /sitemaps.xml (SEOPress) je vlastní soubor se stejným obsahem jako /sitemap.xml
  RewriteRule ^(wp-sitemap|sitemap_index|[a-z_]+-sitemap\d*)\.xml$ /sitemap.xml [L,R=301]
  RewriteRule ^wp-(admin|login\.php).*$ / [L,R=302]
  RewriteRule ^category/.*$ /blog/ [L,R=301]
  RewriteRule ^(feed|comments/feed)/?$ / [L,R=301]
  # RSS kanály jednotlivých stránek z WordPressu (…/feed/) → stránka samotná
  RewriteRule ^(.+)/feed/?$ /$1/ [L,R=301]
  RewriteRule ^domu/?$ / [L,R=301]
  # Obrázky z WordPressu → WebP verze (zachová staré odkazy a obrázky ve vyhledávání)
  RewriteRule ^wp-content/uploads/.+-\d+x\d+\.(jpe?g|png|webp|gif)$ - [S=1]
  RewriteRule ^wp-content/uploads/(.+)\.(jpe?g|png|webp|gif)$ /obrazky/$1.webp [L,R=301]
  RewriteRule ^wp-content/uploads/(.+)-\d+x\d+\.(jpe?g|png|webp|gif)$ /obrazky/$1.webp [L,R=301]
  RewriteRule ^wp-content/uploads/(.+)\.avif$ /obrazky/$1.avif [L,R=301]
  # Přejmenované fotky (11/2026): staré adresy obrázků → nové názvy
  RewriteRule ^(obrazky|nahledy)/2025/03/1f8a2b90-6bf9-46b2-a731-c0d3b7b7d19d-scaled\.(webp|avif)$ /$1/2025/03/cafe-datel-ceske-budejovice-foto-1.$2 [L,R=301]
  RewriteRule ^(obrazky|nahledy)/2025/03/20e0f276-6c86-47f3-bd41-0be0dd803423-scaled\.(webp|avif)$ /$1/2025/03/coffee-library-olomouc-foto-1.$2 [L,R=301]
  RewriteRule ^(obrazky|nahledy)/2025/03/21febd67-be66-4173-9aa6-b5ef518ea825-scaled\.(webp|avif)$ /$1/2025/03/walter-plzen-foto-1.$2 [L,R=301]
