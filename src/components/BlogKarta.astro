---
import Foto from './Foto.astro';
import { clanekUrl, perex, kategorie, nazev, type Clanek } from '../lib/blog';

interface Props {
  c: Clanek;
}
const { c } = Astro.props;
---

<li class="bk">
  <a href={clanekUrl(c)}>
    <div class="bk__foto">
      {c.data.image && <Foto src={c.data.image} alt={c.data.title} />}
    </div>
    <span class="bk__kat">{kategorie(c)}</span>
    <h3>{nazev(c)}</h3>
    <p>{perex(c, 140)}</p>
  </a>
</li>

<style>
  .bk a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .bk__foto {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--cream);
  }
  /* Stejné přiblížení fotky jako u karet podniků */
  .bk__foto :global(.foto) {
    transition: transform 0.4s ease;
  }
  .bk a:hover .bk__foto :global(.foto) {
    transform: scale(1.04);
  }
  .bk__kat {
    display: block;
    margin-top: 0.9rem;
    font: 600 0.72rem/1.3 var(--f-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }
  .bk h3 {
    font-size: 1.12rem;
    line-height: 1.3;
    margin: 0.35rem 0 0.4rem;
  }
  .bk a:hover h3 {
    color: var(--accent-deep);
  }
  .bk p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
</style>
