---
import Logo from './Logo.astro';
import { SITE } from '../lib/config';
import { mesta, lokalitaUrl, TEMATA, temaUrl } from '../lib/data';

const topMesta = [...mesta()].sort((a, b) => b.podniky.length - a.podniky.length).slice(0, 8);
const rok = new Date().getFullYear();
interface Props {
  lang?: 'cs' | 'en';
}
const en = Astro.props.lang === 'en';
---

{
  en ? (
<footer class="ftr">
  <div class="wrap ftr__grid">
    <div class="ftr__o">
      <a href="/en/" aria-label="naBrunch.cz – home" class="ftr__logo"><Logo svetle /></a>
      <p>Hand-picked breakfast and brunch spots in Prague and across the Czech Republic – places we have visited ourselves.</p>
      <p class="ftr__soc">
        <a href={SITE.instagram} rel="noopener" target="_blank">Instagram</a>
        <a href={SITE.facebook} rel="noopener" target="_blank">Facebook</a>
      </p>
    </div>
    <nav aria-label="Prague">
      <h2>Prague</h2>
      <ul>
        <li><a href="/en/">Brunch in Prague</a></li>
        <li><a href="/en/best-brunch-prague-old-town/">Breakfast near Old Town</a></li>
      </ul>
    </nav>
    <nav aria-label="naBrunch.cz">
      <h2>naBrunch.cz</h2>
      <ul>
        <li><a href="/" hreflang="cs" lang="cs">Česká verze</a></li>
        <li><a href="/kontakt/">Contact</a></li>
        <li><a href="/ochrana-osobnich-udaju/">Privacy policy (CZ)</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap ftr__spodek">
    <span>© {rok} nabrunch.cz · Picked with love and appetite.</span>
    <a href="https://webovybalicek.cz/" rel="noopener" target="_blank">by webovybalicek</a>
  </div>
</footer>
  ) : (
<footer class="ftr">
  <div class="wrap ftr__grid">
    <div class="ftr__o">
      <a href="/" aria-label="naBrunch.cz – úvod" class="ftr__logo"><Logo svetle /></a>
      <p>Průvodce nejlepšími snídaňovými a brunchovými místy v Česku.</p>
      <p class="ftr__soc">
        <a href={SITE.instagram} rel="noopener" target="_blank">Instagram</a>
        <a href={SITE.facebook} rel="noopener" target="_blank">Facebook</a>
      </p>
    </div>
    <nav aria-label="Města">
      <h2>Města</h2>
      <ul>
        {topMesta.map((m) => <li><a href={lokalitaUrl(m)}>Brunch {m.nazev}</a></li>)}
        <li><a href="/lokality/">Všechna města →</a></li>
        <li><a href="/kavarny/">Kavárny podle měst</a></li>
      </ul>
    </nav>
    <nav aria-label="Podle chuti">
      <h2>Podle chuti</h2>
      <ul>
        {TEMATA.map((t) => <li><a href={temaUrl(t)}>{t.kratce}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Ostatní">
      <h2>Ostatní</h2>
      <ul>
        <li><a href="/pridat-podnik/">Přidat podnik</a></li>
        <li><a href="/o-nas/">O nás</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
        <li><a href="/casto-kladene-dotazy/">Často kladené dotazy</a></li>
        <li><a href="/obchodni-podminky/">Obchodní podmínky</a></li>
        <li><a href="/ochrana-osobnich-udaju/">Ochrana osobních údajů</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap ftr__spodek">
    <span>© {rok} nabrunch.cz · Vybráno s láskou a chutí.</span>
    <a href="https://webovybalicek.cz/" rel="noopener" target="_blank">by webovybalicek</a>
  </div>
</footer>
  )
}

<style>
  .ftr {
    background: var(--brown-dark);
    color: rgb(255 255 255 / 0.82);
    padding-top: clamp(40px, 6vw, 72px);
    font-size: 0.92rem;
  }
  .ftr a {
    color: #fff;
    text-decoration: none;
  }
  .ftr a:hover {
    color: var(--accent);
  }
  .ftr__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 2rem;
  }
  .ftr__logo {
    display: inline-block;
    margin-bottom: 1rem;
  }
  .ftr h2 {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .ftr ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .ftr__soc {
    display: flex;
    gap: 1.25rem;
    font-weight: 600;
  }
  .ftr__spodek {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(32px, 5vw, 56px);
    padding-block: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: 0.82rem;
    color: rgb(255 255 255 / 0.6);
  }
  @media (max-width: 820px) {
    .ftr__grid {
      grid-template-columns: 1fr 1fr;
    }
    .ftr__o {
      grid-column: 1 / -1;
    }
  }
</style>
