---
import Logo from './Logo.astro';
interface Props {
  lang?: 'cs' | 'en';
  alternates?: { cs?: string; en?: string };
}
const { lang = 'cs', alternates } = Astro.props;
const en = lang === 'en';
// Na úvodní stránce je hlavička průhledná přes gradient, po posunu stránky dostane bílé pozadí
const pruhledna = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
// Přepínač jazyka jen tam, kde existuje druhá verze stránky
const jinyJazyk = en ? { href: alternates?.cs ?? '/', text: 'Česky', kod: 'CZ' } : alternates?.en ? { href: alternates.en, text: 'English', kod: 'EN' } : undefined;
---

<header class:list={['hdr', pruhledna && 'hdr--pruhledna']} data-hdr>
  <div class="wrap hdr__in">
    <a href={en ? '/en/' : '/'} class="hdr__logo" aria-label={en ? 'naBrunch.cz – home' : 'naBrunch.cz – úvod'}><Logo /></a>
    {
      en ? (
        <nav aria-label="Main menu">
          <ul>
            <li><a href="/en/">Brunch in Prague</a></li>
            <li class="nav-skryt-m"><a href="/en/best-brunch-prague-old-town/">Old Town guide</a></li>
            {jinyJazyk && <li><a href={jinyJazyk.href} class="btn btn--ghost hdr__lang" hreflang="cs" lang="cs" aria-label={jinyJazyk.text}>{jinyJazyk.kod}</a></li>}
          </ul>
        </nav>
      ) : (
        <>
            <nav aria-label="Hlavní menu">
              <ul>
                <li class="nav-skryt-m"><a href="/podniky/">Přehled podniků</a></li>
                <li class="nav-skryt-m"><a href="/mapa/">Mapa</a></li>
                <li class="nav-skryt-m"><a href="/otevreno-ted/">Otevřeno teď</a></li>
                <li class="nav-skryt-m"><a href="/blog/">Blog</a></li>
                <li class="nav-skryt-m"><a href="/o-nas/">O nás</a></li>
                <li>
                  <a href="/oblibene/" class="hdr__obl" aria-label="Oblíbené podniky">
                    <svg viewBox="0 0 24 24" aria-hidden="true"
                      ><path d="M12 20.5s-7.5-4.6-9.3-9.4C1.4 7.6 3.6 4 7.2 4c2 0 3.6 1.1 4.8 2.8C13.2 5.1 14.8 4 16.8 4c3.6 0 5.8 3.6 4.5 7.1-1.8 4.8-9.3 9.4-9.3 9.4z"></path></svg
                    >
                    <span class="hdr__obl-pocet" data-pocet-oblibenych hidden></span>
                  </a>
                </li>
                {jinyJazyk && <li><a href={jinyJazyk.href} class="btn btn--ghost hdr__lang" hreflang="en" lang="en" aria-label={jinyJazyk.text}>{jinyJazyk.kod}</a></li>}
        <li class="nav-skryt-m"><a href="/pridat-podnik/" class="btn btn--akcent hdr__cta">Přidat podnik</a></li>
                <li class="nav-jen-m">
                  <button type="button" class="hdr__burger" aria-expanded="false" aria-controls="mobilni-menu" data-burger>
                    <span class="sr-only">Menu</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
                  </button>
                </li>
              </ul>
            </nav>
            <div class="mmenu" id="mobilni-menu" data-mmenu hidden>
              <ul>
                <li><a href="/podniky/">Přehled podniků</a></li>
                <li><a href="/mapa/">Mapa podniků</a></li>
                <li><a href="/otevreno-ted/">Otevřeno teď</a></li>
                <li><a href="/blog/">Blog</a></li>
                <li><a href="/oblibene/">Oblíbené</a></li>
                <li><a href="/o-nas/">O nás</a></li>
                <li><a href="/kontakt/">Kontakt</a></li>
              </ul>
              <a class="btn btn--akcent" href="/pridat-podnik/">Přidat podnik</a>
            </div>
        </>
      )
    }
  </div>
</header>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr].hdr--pruhledna');
  if (hdr) {
    const obnov = () => hdr.classList.toggle('hdr--posunuta', scrollY > 8);
    obnov();
    addEventListener('scroll', obnov, { passive: true });
  }
  const btn = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-mmenu]');
  if (btn && menu) {
    const nastav = (on: boolean) => {
      menu.hidden = !on;
      btn.setAttribute('aria-expanded', String(on));
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      nastav(menu.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !menu.contains(e.target as Node)) nastav(false);
    });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && nastav(false));
  }
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  /* Úvodní stránka: průhledná hlavička nad gradientem */
  .hdr--pruhledna {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
    transition: background 0.25s, border-color 0.25s, backdrop-filter 0.25s, box-shadow 0.25s;
  }
  .hdr--pruhledna.hdr--posunuta {
    background: rgb(255 255 255 / 0.88);
    border-bottom-color: var(--line);
    backdrop-filter: saturate(1.4) blur(10px);
  }
  .hdr--pruhledna .hdr__burger:not([aria-expanded='true']) {
    background: rgb(255 255 255 / 0.6);
  }
  .hdr__in {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 70px;
  }
  .hdr__lang {
    padding: 0.35em 0.8em;
    font-size: 0.82rem;
  }
  .hdr__logo {
    text-decoration: none;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(0.9rem, 2.4vw, 2rem);
    align-items: center;
    font-family: var(--f-display);
    font-size: 0.92rem;
    font-weight: 500;
  }
  nav a {
    text-decoration: none;
    white-space: nowrap;
    color: var(--brown-dark);
  }
  nav a:not(.btn):hover {
    color: var(--accent-deep);
  }
  .hdr__cta {
    padding: 0.6em 1.15em;
    font-size: 0.88rem;
  }
  .hdr__obl {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
  }
  .hdr__obl svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .hdr__obl-pocet {
    position: absolute;
    top: -0.1rem;
    right: -0.25rem;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.05rem;
    text-align: center;
  }
  .nav-jen-m {
    display: none;
  }
  .hdr__burger {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    color: var(--brown-dark);
    cursor: pointer;
  }
  .hdr__burger svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }
  .hdr__burger[aria-expanded='true'] {
    background: var(--brown-dark);
    border-color: var(--brown-dark);
    color: #fff;
  }
  .mmenu {
    position: absolute;
    top: 100%;
    left: var(--gutter);
    right: var(--gutter);
    padding: 0.5rem 1.25rem 1.25rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 16px 40px rgb(83 42 25 / 0.16);
  }
  .mmenu[hidden] {
    display: none;
  }
  .mmenu ul {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .mmenu li a {
    display: block;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--f-display);
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--brown-dark);
  }
  .mmenu .btn {
    display: flex;
  }
  @media (max-width: 900px) {
    .nav-skryt-m {
      display: none;
    }
    .nav-jen-m {
      display: list-item;
    }
  }
</style>
