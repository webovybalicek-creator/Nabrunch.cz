---
// Mapa podniků (Leaflet + OpenStreetMap). Načte se, až když je vidět.
import { url, type Podnik } from '../lib/data';

interface Props {
  podniky: Podnik[];
  popis: string;
  vysoka?: boolean;
  /** Další body [lat, lon, název, url, adresa, 2 = neověřená kavárna] */
  body?: (string | number)[][];
  /** Přepínač „Zobrazit i neověřené kavárny“ (načte /kavarny.json až po zapnutí) */
  kavarny?: boolean;
}
const { podniky, popis, vysoka = false, body: dalsi = [], kavarny = false } = Astro.props;
const body = [
  ...podniky.filter((p) => p.lat != null && p.lon != null).map((p) => [p.lat, p.lon, p.nazev, url(p), p.adresa, p.doporuceny ? 1 : 0]),
  ...dalsi,
];
---

{
  kavarny && (
    <label class="mapa-prepinac">
      <input type="checkbox" data-mapa-kavarny /> Zobrazit i neověřené kavárny <span class="muted">(šedé body, údaje z OpenStreetMap)</span>
    </label>
  )
}
<div class:list={['mapa', vysoka && 'mapa--vysoka']} data-mapa={JSON.stringify(body)} role="region" aria-label={popis}></div>

<script>
  import 'leaflet/dist/leaflet.css';

  document.querySelectorAll<HTMLElement>('[data-mapa]').forEach((el) => {
    const nacti = async () => {
      const L = (await import('leaflet')).default;
      const body = JSON.parse(el.dataset.mapa!) as [number, number, string, string, string, number][];
      const map = L.map(el, { scrollWheelZoom: false, preferCanvas: true });
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
      const bod = ([lat, lon, nazev, href, adresa, druh]: [number, number, string, string, string, number]) =>
        L.circleMarker([lat, lon], {
          radius: druh === 1 ? 9 : druh === 2 ? 5 : 7,
          color: '#ffffff',
          weight: druh === 2 ? 1 : 2,
          fillColor: druh === 1 ? '#CE693F' : druh === 2 ? '#9a8f89' : '#FF8E5F',
          fillOpacity: druh === 2 ? 0.85 : 1,
        }).bindPopup(
          `<a href="${href}">${esc(nazev)}</a><br><small>${esc(adresa)}</small>${druh === 2 ? '<br><small style="color:#8a6116">Neověřená kavárna</small>' : ''}`,
        );
      const vrstva = L.featureGroup(body.map(bod)).addTo(map);
      // Neověřené kavárny – načtou se až po zapnutí přepínače
      const prepinac = el.previousElementSibling?.querySelector<HTMLInputElement>('[data-mapa-kavarny]');
      if (prepinac) {
        let kv: any = null;
        prepinac.addEventListener('change', async () => {
          if (prepinac.checked) {
            if (!kv) {
              const data = (await (await fetch('/kavarny.json')).json()) as [number, number, string, string, string][];
              kv = L.featureGroup(data.map((d) => bod([...d, 2] as never)));
            }
            kv.addTo(map);
            vrstva.bringToFront();
          } else kv?.remove();
        });
      }
      if (body.length) map.fitBounds(vrstva.getBounds(), { padding: [28, 28], maxZoom: 15 });
      else map.setView([49.8, 15.5], 7);
      el.addEventListener('click', () => map.scrollWheelZoom.enable(), { once: true });
      // Tlačítko „U mě“ na stránce /mapa/
      const naPolohu = ([lat, lon]: [number, number]) => {
        L.circleMarker([lat, lon], { radius: 7, color: '#fff', weight: 3, fillColor: '#2563eb', fillOpacity: 1 }).addTo(map);
        map.setView([lat, lon], 13);
      };
      if ((window as any).__nbPoloha) naPolohu((window as any).__nbPoloha);
      window.addEventListener('nb-poloha', (e) => naPolohu((e as CustomEvent).detail));
    };
    window.addEventListener('nb-poloha', (e) => ((window as any).__nbPoloha = (e as CustomEvent).detail));
    const io = new IntersectionObserver((e) => {
      if (e[0].isIntersecting) {
        io.disconnect();
        nacti();
      }
    });
    io.observe(el);
  });
</script>

<style>
  .mapa {
    width: 100%;
    aspect-ratio: 16 / 8;
    min-height: 300px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--blush);
    z-index: 0;
  }
  .mapa-prepinac {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .mapa--vysoka {
    aspect-ratio: auto;
    height: min(72vh, 720px);
  }
</style>
