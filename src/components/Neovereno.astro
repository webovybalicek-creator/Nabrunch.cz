---
// Štítek / upozornění u kaváren, které jsme osobně neověřili
interface Props {
  velky?: boolean;
}
const { velky = false } = Astro.props;
---

{
  velky ? (
    <aside class="neov">
      <strong>Neověřeno</strong> – tuhle kavárnu jsme zatím osobně nenavštívili. Údaje pochází z OpenStreetMap a z webu kavárny, proto
      se můžou lišit. Byli jste tu, nebo jste majitel? <a href="/pridat-podnik/">Dejte nám vědět</a>.
    </aside>
  ) : (
    <span class="neov-stitek" title="Údaje z OpenStreetMap, kavárnu jsme zatím osobně neověřili">Neověřeno</span>
  )
}

<style>
  .neov {
    margin: 1rem 0 0;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    background: #fff8e8;
    border: 1px solid #f3e1b5;
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 46rem;
  }
  .neov-stitek {
    display: inline-block;
    padding: 0.2em 0.7em;
    border-radius: 999px;
    background: #fff8e8;
    border: 1px solid #f3e1b5;
    color: #8a6116;
    font: 600 0.75rem/1.3 var(--f-display);
    vertical-align: middle;
  }
</style>
