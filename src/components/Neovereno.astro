---
// Štítek / upozornění u kaváren, které jsme osobně neověřili
interface Props {
  velky?: boolean;
  /** Datum ověření majitelem */
  overeno?: string;
}
const { velky = false, overeno } = Astro.props;
---

{
  overeno ? (
    velky ? (
      <aside class="neov neov--ok">
        <strong>✓ Údaje ověřil majitel</strong> ({new Date(overeno).toLocaleDateString('cs-CZ')}). My jsme tu osobně zatím nebyli – proto kavárna
        není mezi našimi doporučenými podniky.
      </aside>
    ) : (
      <span class="neov-stitek neov-stitek--ok" title="Údaje kavárny ověřil a doplnil majitel">✓ Ověřeno majitelem</span>
    )
  ) : velky ? (
    <aside class="neov">
      <strong>Neověřeno</strong> – tuhle kavárnu jsme zatím osobně nenavštívili. Údaje pochází z OpenStreetMap a z webu kavárny, proto
      se můžou lišit. <a href="#majitel">Jste majitel? Převezměte správu</a> · <a href="mailto:karolina@nabrunch.cz?subject=Chyba%20u%20kav%C3%A1rny">Našli jste chybu?</a>
    </aside>
  ) : (
    <span class="neov-stitek" title="Údaje z OpenStreetMap, kavárnu jsme zatím osobně neověřili">Neověřeno</span>
  )
}

<style>
  .neov {
    margin: 1rem 0 0;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    background: #fff8e8;
    border: 1px solid #f3e1b5;
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 46rem;
  }
  .neov-stitek {
    display: inline-block;
    padding: 0.2em 0.7em;
    border-radius: 999px;
    background: #fff8e8;
    border: 1px solid #f3e1b5;
    color: #8a6116;
    font: 600 0.75rem/1.3 var(--f-display);
    vertical-align: middle;
  }
  .neov--ok {
    background: var(--green-soft);
    border-color: #d5e4cc;
  }
  .neov-stitek--ok {
    background: var(--green-soft);
    border-color: #d5e4cc;
    color: var(--green);
  }
</style>
