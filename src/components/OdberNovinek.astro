---
// Přihlášení k newsletteru (Ecomail přes /api/odber.php)
---

<section class="odber">
  <div class="wrap odber__in">
    <div>
      <h2>Newsletter 💌</h2>
      <p>Miluješ snídaně a brunche stejně jako my? Přihlas se k odběru a jednou za čas ti pošleme tipy na ty nejzajímavější podniky, novinky a inspiraci.</p>
    </div>
    <form class="odber__form" data-odber novalidate>
      <div class="odber__pole">
        <label class="sr-only" for="odber-email">E-mail</label>
        <input id="odber-email" type="email" name="email" required placeholder="tvuj@email.cz" autocomplete="email" />
        <button class="odber__btn" type="submit">
          <span data-btn-text>Chci tipy</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
        </button>
      </div>
      <input class="odber__past" name="web2" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="t" data-cas />
      <p class="odber__zprava" data-zprava role="status" hidden></p>
      <p class="odber__gdpr">Přihlášením souhlasíš se <a href="/ochrana-osobnich-udaju/">zpracováním e-mailu</a>. Odhlásit se můžeš jedním klikem.</p>
    </form>
  </div>
</section>

<script>
  const JIDLA = ['🥐', '🥞', '☕', '🍳', '🍓', '🥑', '🧇'];

  // Oslava po přihlášení: z tlačítka vyletí pár brunchových emoji
  function oslava(z: HTMLElement) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const r = z.getBoundingClientRect();
    for (let i = 0; i < 18; i++) {
      const e = document.createElement('span');
      e.className = 'odber-konfeta';
      e.textContent = JIDLA[i % JIDLA.length];
      e.style.left = `${r.left + r.width / 2}px`;
      e.style.top = `${r.top + r.height / 2}px`;
      const uhel = (Math.random() * 0.9 + 0.05) * Math.PI;
      const sila = 120 + Math.random() * 160;
      e.style.setProperty('--dx', `${Math.cos(uhel) * sila * (Math.random() < 0.5 ? -1 : 1)}px`);
      e.style.setProperty('--dy', `${-Math.sin(uhel) * sila}px`);
      e.style.setProperty('--rot', `${(Math.random() - 0.5) * 540}deg`);
      document.body.appendChild(e);
      e.addEventListener('animationend', () => e.remove());
    }
  }

  document.querySelectorAll<HTMLFormElement>('[data-odber]').forEach((form) => {
    form.querySelector<HTMLInputElement>('[data-cas]')!.value = String(Math.floor(Date.now() / 1000));
    const zprava = form.querySelector<HTMLElement>('[data-zprava]')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    const btnText = form.querySelector<HTMLElement>('[data-btn-text]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.querySelector<HTMLInputElement>('input[type=email]')!;
      const ukaz = (t: string, ok = false) => {
        zprava.textContent = t;
        zprava.hidden = false;
        zprava.classList.toggle('ok', ok);
      };
      if (!email.checkValidity()) {
        form.classList.remove('zatres');
        void form.offsetWidth;
        form.classList.add('zatres');
        return ukaz('Zkontroluj prosím e-mail.');
      }
      btn.disabled = true;
      btnText.textContent = 'Přihlašuji…';
      const fd = new FormData(form);
      fd.set('zdroj', location.pathname);
      try {
        const d = await (await fetch('/api/odber.php', { method: 'POST', body: fd })).json();
        if (d.ok) {
          ukaz('Hotovo! Mrkni do schránky a potvrď přihlášení. 🥐', true);
          form.classList.add('hotovo');
          btnText.textContent = 'Jsi v tom!';
          oslava(btn);
          form.reset();
          return;
        }
        ukaz(d.chyba ?? 'Přihlášení se nepovedlo.');
      } catch {
        ukaz('Přihlášení se nepovedlo. Zkus to prosím znovu.');
      }
      btn.disabled = false;
      btnText.textContent = 'Chci tipy';
    });
  });
</script>

<style>
  /* Výrazný oranžový pruh nad patičkou (stejný na všech stránkách) */
  .odber {
    position: relative;
    padding-block: clamp(40px, 6vw, 64px);
    /* Dole končí barvou #f7834f – na úvodu na ni plynule navazuje karta „Přidej podnik“ */
    background:
      radial-gradient(55% 90% at 100% 0%, rgb(255 196 160 / 0.6), transparent 70%),
      radial-gradient(40% 80% at 0% 0%, rgb(255 170 150 / 0.45), transparent 70%),
      linear-gradient(180deg, #ff9b6b, #f7834f);
    color: #fff;
  }
  .odber h2 {
    color: #fff;
  }
  .odber__in > div > p {
    color: rgb(255 255 255 / 0.92);
  }
  .odber__in {
    display: grid;
    grid-template-columns: 1fr minmax(0, 28rem);
    gap: 1.5rem 3rem;
    align-items: center;
  }
  @media (max-width: 820px) {
    .odber__in {
      grid-template-columns: 1fr;
    }
  }
  .odber h2 {
    margin-bottom: 0.4em;
  }
  .odber__in > div > p {
    margin: 0;
  }
  .odber__form {
    position: relative;
    z-index: 1;
  }
  .odber__pole {
    display: flex;
    gap: 0.4rem;
    padding: 0.45rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 14px 34px rgb(83 42 25 / 0.12);
    transition: box-shadow 0.2s;
  }
  .odber__pole:focus-within {
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.55), 0 14px 34px rgb(83 42 25 / 0.18);
  }
  .odber__pole input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 0.7em 1em;
    font: inherit;
    background: transparent;
    color: var(--ink);
  }
  .odber__pole input:focus {
    outline: none;
  }
  .odber__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.85em 1.4em;
    border: 0;
    border-radius: 999px;
    background: var(--brown-dark);
    color: #fff;
    font: 600 0.95rem var(--f-display);
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .odber__btn:hover:not(:disabled) {
    transform: translateY(-1px);
    background: var(--brown);
    box-shadow: 0 8px 20px rgb(83 42 25 / 0.3);
  }
  .odber__btn svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }
  .odber__btn:hover svg {
    transform: translateX(3px);
  }
  .odber__form:global(.hotovo) .odber__btn {
    background: var(--green);
  }
  .odber__form:global(.zatres) .odber__pole {
    animation: zatres 0.4s ease;
  }
  @keyframes zatres {
    20%,
    60% {
      transform: translateX(-6px);
    }
    40%,
    80% {
      transform: translateX(6px);
    }
  }
  .odber__past {
    position: absolute;
    left: -9999px;
  }
  .odber__zprava {
    margin: 0.9rem 0 0;
    padding-left: 1rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: #fff;
  }
  .odber__zprava:global(.ok) {
    color: #fff;
  }
  .odber__gdpr {
    margin: 0.8rem 0 0;
    padding-left: 1rem;
    font-size: 0.76rem;
    color: rgb(255 255 255 / 0.85);
  }
  .odber__gdpr a {
    color: #fff;
  }
  .odber__gdpr a:hover {
    color: var(--brown-dark);
  }
  @media (max-width: 480px) {
    .odber__pole {
      flex-direction: column;
      border-radius: 22px;
    }
    .odber__btn {
      justify-content: center;
    }
  }
  :global(.odber-konfeta) {
    position: fixed;
    z-index: 100;
    font-size: 1.6rem;
    pointer-events: none;
    transform: translate(-50%, -50%);
    animation: konfeta 1.1s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }
  @keyframes konfeta {
    to {
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy) + 120px)) rotate(var(--rot));
      opacity: 0;
    }
  }
</style>
