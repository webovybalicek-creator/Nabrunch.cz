---
// Přihlášení k newsletteru (Ecomail přes /api/odber.php)
---

<section class="odber" data-odber-sekce>
  <div class="wrap">
    <div class="odber__karta">
      <span class="odber__deko odber__deko--1" aria-hidden="true">🥐</span>
      <span class="odber__deko odber__deko--2" aria-hidden="true">☕</span>
      <span class="odber__deko odber__deko--3" aria-hidden="true">🍳</span>
      <span class="odber__deko odber__deko--4" aria-hidden="true">🥞</span>
      <span class="odber__deko odber__deko--5" aria-hidden="true">🍓</span>

      <div class="odber__text">
        <span class="odber__stitek">💌 Brunch newsletter</span>
        <h2>Nové brunche ti doneseme <span>až do schránky</span></h2>
        <ul class="odber__vyhody">
          <li>Nově otevřená místa dřív než ostatní</li>
          <li>Tipy na víkend podle města</li>
          <li>Žádný spam, max. párkrát za měsíc</li>
        </ul>
      </div>

      <form class="odber__form" data-odber novalidate>
        <div class="odber__pole">
          <label class="sr-only" for="odber-email">E-mail</label>
          <input id="odber-email" type="email" name="email" required placeholder="tvuj@email.cz" autocomplete="email" />
          <button class="odber__btn" type="submit">
            <span data-btn-text>Chci tipy</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
          </button>
        </div>
        <input class="odber__past" name="web2" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="t" data-cas />
        <p class="odber__zprava" data-zprava role="status" hidden></p>
        <p class="odber__gdpr">Přihlášením souhlasíš se <a href="/ochrana-osobnich-udaju/">zpracováním e-mailu</a>. Odhlásit se můžeš jedním klikem.</p>
      </form>
    </div>
  </div>
</section>

<script>
  const JIDLA = ['🥐', '🥞', '☕', '🍳', '🍓', '🥑', '🧇'];

  // Oslava po přihlášení: z tlačítka vyletí pár brunchových emoji
  function oslava(z: HTMLElement) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const r = z.getBoundingClientRect();
    for (let i = 0; i < 18; i++) {
      const e = document.createElement('span');
      e.className = 'odber-konfeta';
      e.textContent = JIDLA[i % JIDLA.length];
      e.style.left = `${r.left + r.width / 2}px`;
      e.style.top = `${r.top + r.height / 2}px`;
      const uhel = (Math.random() * 0.9 + 0.05) * Math.PI;
      const sila = 120 + Math.random() * 160;
      e.style.setProperty('--dx', `${Math.cos(uhel) * sila * (Math.random() < 0.5 ? -1 : 1)}px`);
      e.style.setProperty('--dy', `${-Math.sin(uhel) * sila}px`);
      e.style.setProperty('--rot', `${(Math.random() - 0.5) * 540}deg`);
      document.body.appendChild(e);
      e.addEventListener('animationend', () => e.remove());
    }
  }

  document.querySelectorAll<HTMLFormElement>('[data-odber]').forEach((form) => {
    form.querySelector<HTMLInputElement>('[data-cas]')!.value = String(Math.floor(Date.now() / 1000));
    const zprava = form.querySelector<HTMLElement>('[data-zprava]')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    const btnText = form.querySelector<HTMLElement>('[data-btn-text]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.querySelector<HTMLInputElement>('input[type=email]')!;
      const ukaz = (t: string, ok = false) => {
        zprava.textContent = t;
        zprava.hidden = false;
        zprava.classList.toggle('ok', ok);
      };
      if (!email.checkValidity()) {
        form.classList.remove('zatres');
        void form.offsetWidth;
        form.classList.add('zatres');
        return ukaz('Zkontroluj prosím e-mail.');
      }
      btn.disabled = true;
      btnText.textContent = 'Přihlašuji…';
      const fd = new FormData(form);
      fd.set('zdroj', location.pathname);
      try {
        const d = await (await fetch('/api/odber.php', { method: 'POST', body: fd })).json();
        if (d.ok) {
          ukaz('Hotovo! Mrkni do schránky a potvrď přihlášení. 🥐', true);
          form.classList.add('hotovo');
          btnText.textContent = 'Jsi v tom!';
          oslava(btn);
          form.reset();
          return;
        }
        ukaz(d.chyba ?? 'Přihlášení se nepovedlo.');
      } catch {
        ukaz('Přihlášení se nepovedlo. Zkus to prosím znovu.');
      }
      btn.disabled = false;
      btnText.textContent = 'Chci tipy';
    });
  });
</script>

<style>
  .odber {
    padding-block: clamp(40px, 6vw, 72px);
  }
  .odber__karta {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr minmax(0, 28rem);
    gap: 2rem clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(28px, 5vw, 56px);
    border-radius: 32px;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(50% 80% at 100% 0%, rgb(255 142 95 / 0.35), transparent 70%),
      radial-gradient(45% 70% at 0% 100%, rgb(255 154 152 / 0.3), transparent 70%),
      linear-gradient(135deg, #fff4ee, #ffe6dc 60%, #ffe3e6);
    box-shadow: 0 24px 60px rgb(206 105 63 / 0.14);
  }
  @media (max-width: 860px) {
    .odber__karta {
      grid-template-columns: 1fr;
    }
  }
  .odber__stitek {
    display: inline-block;
    margin-bottom: 0.9rem;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    background: #fff;
    color: var(--accent-deep);
    font: 600 0.78rem/1.3 var(--f-display);
    box-shadow: 0 4px 14px rgb(206 105 63 / 0.12);
  }
  .odber h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    margin-bottom: 0.6em;
  }
  .odber h2 span {
    color: var(--accent-deep);
  }
  .odber__vyhody {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-weight: 500;
  }
  .odber__vyhody li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .odber__vyhody li::before {
    content: '✓';
    display: grid;
    place-items: center;
    flex: 0 0 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .odber__form {
    position: relative;
    z-index: 1;
  }
  .odber__pole {
    display: flex;
    gap: 0.4rem;
    padding: 0.45rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 14px 34px rgb(83 42 25 / 0.12);
    transition: box-shadow 0.2s;
  }
  .odber__pole:focus-within {
    box-shadow: 0 0 0 3px rgb(255 142 95 / 0.35), 0 14px 34px rgb(83 42 25 / 0.12);
  }
  .odber__pole input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 0.7em 1em;
    font: inherit;
    background: transparent;
    color: var(--ink);
  }
  .odber__pole input:focus {
    outline: none;
  }
  .odber__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.85em 1.4em;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #fff;
    font: 600 0.95rem var(--f-display);
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .odber__btn:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgb(206 105 63 / 0.35);
  }
  .odber__btn svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }
  .odber__btn:hover svg {
    transform: translateX(3px);
  }
  .odber__form:global(.hotovo) .odber__btn {
    background: var(--green);
  }
  .odber__form:global(.zatres) .odber__pole {
    animation: zatres 0.4s ease;
  }
  @keyframes zatres {
    20%,
    60% {
      transform: translateX(-6px);
    }
    40%,
    80% {
      transform: translateX(6px);
    }
  }
  .odber__past {
    position: absolute;
    left: -9999px;
  }
  .odber__zprava {
    margin: 0.9rem 0 0;
    padding-left: 1rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: #9b2c1f;
  }
  .odber__zprava:global(.ok) {
    color: var(--green);
  }
  .odber__gdpr {
    margin: 0.8rem 0 0;
    padding-left: 1rem;
    font-size: 0.76rem;
    color: var(--ink-soft);
  }
  @media (max-width: 480px) {
    .odber__pole {
      flex-direction: column;
      border-radius: 22px;
    }
    .odber__btn {
      justify-content: center;
    }
  }
  /* Plovoucí jídla v pozadí karty */
  .odber__deko {
    position: absolute;
    z-index: -1;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    opacity: 0.85;
    filter: drop-shadow(0 6px 10px rgb(83 42 25 / 0.15));
    animation: vznaseni 6s ease-in-out infinite;
    pointer-events: none;
    user-select: none;
  }
  .odber__deko--1 {
    top: 12%;
    right: 6%;
  }
  .odber__deko--2 {
    bottom: 10%;
    right: 38%;
    animation-delay: -1.5s;
  }
  .odber__deko--3 {
    top: 8%;
    left: 46%;
    animation-delay: -3s;
    font-size: 1.6rem;
  }
  .odber__deko--4 {
    bottom: 8%;
    left: 4%;
    animation-delay: -4.5s;
    opacity: 0.5;
  }
  .odber__deko--5 {
    bottom: 26%;
    right: 3%;
    animation-delay: -2.2s;
    font-size: 1.5rem;
  }
  @keyframes vznaseni {
    50% {
      transform: translateY(-10px) rotate(8deg);
    }
  }
  @media (max-width: 860px) {
    .odber__deko--2,
    .odber__deko--3 {
      display: none;
    }
  }
  :global(.odber-konfeta) {
    position: fixed;
    z-index: 100;
    font-size: 1.6rem;
    pointer-events: none;
    transform: translate(-50%, -50%);
    animation: konfeta 1.1s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }
  @keyframes konfeta {
    to {
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy) + 120px)) rotate(var(--rot));
      opacity: 0;
    }
  }
</style>
