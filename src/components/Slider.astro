---
// Vodorovný slider karet podniků v šířce obsahu: 4 karty na desktopu, posouvání šipkami nebo prstem.
import Karta from './Karta.astro';
import type { Podnik } from '../lib/data';

interface Props {
  podniky: Podnik[];
  eyebrow: string;
  nadpis: string;
  odkaz?: { href: string; text: string };
  /** Tmavá varianta (čokoládové pozadí) */
  tmavy?: boolean;
  /** Při každé návštěvě karty náhodně zamíchat (aby nebyly vidět pořád ty samé) */
  zamichat?: boolean;
}
const { podniky, eyebrow, nadpis, odkaz, tmavy = false, zamichat = false } = Astro.props;
---

<section class:list={['slider', tmavy && 'slider--tmavy']} data-slider data-zamichat={zamichat ? '' : undefined}>
  <div class="wrap">
    <div class="slider__hlava">
      <div>
        <span class="eyebrow">{eyebrow}</span>
        <h2>{nadpis}</h2>
      </div>
      <div class="slider__ovl">
        {odkaz && <a href={odkaz.href} class="slider__odkaz">{odkaz.text} →</a>}
        <button type="button" class="slider__sip" data-krok="-1" aria-label="Předchozí" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <button type="button" class="slider__sip" data-krok="1" aria-label="Další">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
  </div>
  <div class="wrap">
    <ul class="slider__drah" data-drah tabindex="0" aria-label={nadpis}>
      {podniky.map((p) => <Karta p={p} />)}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const drah = root.querySelector<HTMLElement>('[data-drah]')!;
    const [zpet, dal] = root.querySelectorAll<HTMLButtonElement>('[data-krok]');
    if (root.hasAttribute('data-zamichat')) {
      const karty = [...drah.children];
      for (let i = karty.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [karty[i], karty[j]] = [karty[j], karty[i]];
      }
      karty.forEach((k) => drah.appendChild(k));
    }
    const obnov = () => {
      const max = drah.scrollWidth - drah.clientWidth;
      zpet.disabled = drah.scrollLeft <= 4;
      dal.disabled = drah.scrollLeft >= max - 4;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-krok]').forEach((b) =>
      b.addEventListener('click', () => {
        const karta = drah.querySelector<HTMLElement>('.karta');
        const krok = karta ? karta.offsetWidth + parseFloat(getComputedStyle(drah).columnGap || '0') : drah.clientWidth;
        const naObrazovku = Math.max(1, Math.floor(drah.clientWidth / krok));
        drah.scrollBy({ left: Number(b.dataset.krok) * krok * naObrazovku, behavior: 'smooth' });
      }),
    );
    drah.addEventListener('scroll', obnov, { passive: true });
    addEventListener('resize', obnov);
    obnov();
  });
</script>

<style>
  .slider {
    padding-block: clamp(48px, 7vw, 88px);
    overflow: hidden;
  }
  .slider--tmavy {
    background: var(--blush);
  }
  .slider__hlava {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .slider__hlava h2 {
    margin: 0;
  }
  .slider__ovl {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .slider__odkaz {
    margin-right: 0.75rem;
    font: 600 0.92rem var(--f-display);
    color: var(--brown-dark);
    text-decoration: none;
  }
  .slider__odkaz:hover {
    color: var(--accent-deep);
  }
  .slider__sip {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #fff;
    color: var(--brown-dark);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s, opacity 0.15s;
  }
  .slider__sip:hover:not(:disabled) {
    background: var(--brown-dark);
    border-color: var(--brown-dark);
    color: #fff;
  }
  .slider__sip:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .slider__sip svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* 4 karty vedle sebe v šířce obsahu, další se odsouvají (nic nepřetéká ven ze sekce) */
  .slider__drah {
    --mezera: clamp(0.9rem, 2vw, 1.5rem);
    list-style: none;
    margin: -0.5rem -0.5rem 0;
    padding: 0.5rem 0.5rem 1.25rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * var(--mezera)) / 4);
    column-gap: var(--mezera);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.5rem;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .slider__drah::-webkit-scrollbar {
    display: none;
  }
  .slider__drah:focus-visible {
    outline: none;
  }
  .slider__drah :global(.karta) {
    scroll-snap-align: start;
  }
  .slider__drah :global(.karta__foto) {
    aspect-ratio: 4 / 5;
    box-shadow: 0 10px 22px rgb(83 42 25 / 0.1);
  }
  @media (max-width: 1000px) {
    .slider__drah {
      grid-auto-columns: calc((100% - 2 * var(--mezera)) / 3);
    }
  }
  @media (max-width: 760px) {
    .slider__drah {
      grid-auto-columns: calc((100% - var(--mezera)) / 2);
    }
  }
  @media (max-width: 640px) {
    .slider__drah {
      grid-auto-columns: 78%;
    }
    .slider__sip {
      display: none;
    }
    .slider__odkaz {
      margin: 0;
    }
  }
</style>
