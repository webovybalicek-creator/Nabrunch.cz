---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../Breadcrumb.astro';
import Foto from '../Foto.astro';
import Karta from '../Karta.astro';
import BlogKarta from '../BlogKarta.astro';
import { SITE } from '../../lib/config';
import { getCollection } from 'astro:content';
import { EN_INDEXOVAT } from '../../lib/en';
import { velky, obrazkyVHtml, PODNIKY, altFoto, mesta, lokalitaUrl, podnikuText } from '../../lib/data';
import { slugify } from '../../lib/slug';
import { nazev, clanky, clanekUrl, kategorie, kategorieUrl, casCteni, datumText, perex, souvisejici, zminenePodniky, type Clanek } from '../../lib/blog';

interface Props {
  c: Clanek;
}
const { c } = Astro.props;
const enClanek = EN_INDEXOVAT ? (await getCollection('blogEn')).find((e) => e.data.cs === clanekUrl(c)) : undefined;
const alternates = enClanek ? { cs: clanekUrl(c), en: `/en/${enClanek.id}/` } : undefined;
const vse = await clanky();
// Blok „Kam na kávu a snídani“ na konci článku: nejčastější města
const mestaCta = [...mesta()].sort((a, b) => b.podniky.length - a.podniky.length).slice(0, 6);
const kat = kategorie(c);
const podniky = zminenePodniky(c).slice(0, 8);
// Prvních 6 souvisejících: 3 v bočním panelu „Čtěte také“, další 3 jako karty pod článkem
const souvis = souvisejici(vse, c, 6);
const dalsi = souvis.slice(3);
const popis = perex(c);
const titulek = c.data.seoTitle?.replace(/\s*[-–|]\s*naBrunch\.cz\s*$/i, '') || c.data.title;
// Obsah z WordPressu: první obrázek v textu nevykreslovat dvakrát, pokud je stejný jako úvodní
let html = (c.body ?? '').replace(/<h1(\s[^>]*)?>([\s\S]*?)<\/h1>/gi, '<h2$1>$2</h2>');
if (c.data.image) {
  const zaklad = c.data.image.replace(/\.[a-z0-9]+$/i, '');
  html = html.replace(new RegExp(`^\\s*<figure[^>]*>\\s*<img[^>]*${zaklad.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}[^>]*>\\s*</figure>`), '');
}

// Recept z frontmatteru: karta na místě značky <!-- recept --> (jinak na začátek textu)
const r = c.data.recept;
if (r) {
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const info = [`Porce: ${r.porce}`, `Příprava: ${r.priprava} min`, ...(r.vareni ? [`Vaření/pečení: ${r.vareni} min`] : []), `Celkem: ${r.priprava + r.vareni} min`];
  const karta =
    `<section class="recept"><h2>Recept: ${esc(r.nazev)}</h2>` +
    `<ul class="recept__info">${info.map((i) => `<li>${esc(i)}</li>`).join('')}</ul>` +
    `<h3>Suroviny</h3><ul class="recept__suroviny">${r.suroviny.map((i) => `<li>${esc(i)}</li>`).join('')}</ul>` +
    `<h3>Postup</h3><ol class="recept__postup">${r.postup.map((i) => `<li>${esc(i)}</li>`).join('')}</ol></section>`;
  html = html.includes('<!-- recept -->') ? html.replace('<!-- recept -->', karta) : karta + html;
}

// Obsah článku: nadpisy H2 dostanou kotvy (id) pro odkazy z bočního panelu
const nadpisy: { id: string; text: string }[] = [];
const pouzite = new Set<string>();
html = html.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/gi, (_, attrs: string, vnitrek: string) => {
  const text = vnitrek.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();
  if (!text) return `<h2${attrs}>${vnitrek}</h2>`;
  let id = slugify(text).slice(0, 60) || 'cast';
  for (let i = 2; pouzite.has(id); i++) id = `${slugify(text).slice(0, 56)}-${i}`;
  pouzite.add(id);
  // Dlouhé nadpisy (z WP bývá jako H2 celá úvodní věta) v obsahu zkrátit
  nadpisy.push({ id, text: text.length > 55 ? `${text.slice(0, 50).replace(/\s+\S*$/, '')}…` : text });
  return `<h2${attrs.replace(/\sid="[^"]*"/, '')} id="${id}">${vnitrek}</h2>`;
});
const ctete = souvis.slice(0, 3);

// Obrázky z WordPressu mají prázdný alt: doplnit podnik, na který obrázek odkazuje, jinak nejbližší nadpis nebo titulek článku
{
  let posledni = nazev(c);
  let cislo = 0;
  html = html.replace(/<h2[^>]*>([\s\S]*?)<\/h2>|(<a [^>]*href="\/podniky\/([^"/]+)\/?"[^>]*>\s*)?<img\b([^>]*?)\salt=""/gi, (cele, h2, odkaz, slug, pred) => {
    if (h2 !== undefined) {
      const t = h2.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/👉🏼|\d+\.\s/g, '').replace(/\s+/g, ' ').trim();
      if (t) posledni = t;
      return cele;
    }
    const podnik = slug ? PODNIKY.find((x) => x.slug === slug) : undefined;
    const alt = podnik ? altFoto(podnik) : `${posledni}${++cislo > 1 ? ` – foto ${cislo}` : ''}`;
    return `${odkaz ?? ''}<img${pred} alt="${alt.replace(/"/g, '&quot;')}"`;
  });
}

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: c.data.title,
  description: popis,
  datePublished: c.data.date.toISOString(),
  ...(c.data.image ? { image: new URL(velky(c.data.image), SITE.url).href } : {}),
  mainEntityOfPage: new URL(clanekUrl(c), SITE.url).href,
  author: { '@type': 'Organization', name: SITE.nazev, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.nazev, url: SITE.url },
};
const jsonLd = r
  ? [
      blogPosting,
      {
        '@context': 'https://schema.org',
        '@type': 'Recipe',
        name: r.nazev,
        description: popis,
        ...(c.data.image ? { image: [new URL(velky(c.data.image), SITE.url).href] } : {}),
        author: { '@type': 'Organization', name: SITE.nazev, url: SITE.url },
        datePublished: c.data.date.toISOString(),
        prepTime: `PT${r.priprava}M`,
        ...(r.vareni ? { cookTime: `PT${r.vareni}M` } : {}),
        totalTime: `PT${r.priprava + r.vareni}M`,
        recipeYield: r.porce,
        recipeCategory: r.kategorie,
        recipeCuisine: 'česká',
        ...(r.klicova ? { keywords: r.klicova.join(', ') } : {}),
        recipeIngredient: r.suroviny,
        recipeInstructions: r.postup.map((t, i) => ({ '@type': 'HowToStep', position: i + 1, text: t })),
      },
    ]
  : blogPosting;
---

<Base title={titulek} description={popis} obrazek={c.data.image} typ="article" publikovano={c.data.date.toISOString()} jsonLd={jsonLd} alternates={alternates}>
  <article>
    <header class="clanek-head">
      <div class="wrap">
        <Breadcrumb polozky={[{ nazev: 'Blog', url: '/blog/' }, { nazev: kat, url: kategorieUrl(kat) }, { nazev: nazev(c) }]} />
        <h1>{nazev(c)}</h1>
        <p class="meta muted">
          <time datetime={c.data.date.toISOString()}>{datumText(c.data.date)}</time> · {casCteni(c)} min čtení ·
          <a href={kategorieUrl(kat)}>{kat}</a>
        </p>
      </div>
    </header>
    {
      c.data.image && (
        <div class="wrap">
          <div class="clanek-foto">
            <Foto src={c.data.image} alt={c.data.title} plna eager />
          </div>
        </div>
      )
    }
    <div class="wrap telo">
      <aside class="bok">
        <div class="bok__in">
          {
            nadpisy.length > 2 && (
              <nav class="toc" aria-label="Obsah článku" data-toc>
                <p class="toc__h">Obsah</p>
                <ol>
                  {nadpisy.map((h) => (
                    <li>
                      <a href={`#${h.id}`}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          {
            ctete.length > 0 && (
              <nav class="ctete" aria-label="Čtěte také">
                <p class="toc__h">Čtěte také</p>
                <ul>
                  {ctete.map((x) => (
                    <li>
                      <a href={clanekUrl(x)}>{nazev(x)}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </div>
      </aside>
      <div>
        {
          nadpisy.length > 2 && (
            <details class="toc-m">
              <summary>Obsah článku</summary>
              <ol>
                {nadpisy.map((h) => (
                  <li>
                    <a href={`#${h.id}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }
        <div class="prose clanek-text" set:html={obrazkyVHtml(html)} />
        <aside class="cta" aria-label="Kam na kávu a snídani">
          <p class="cta__h">☕ Kam na kávu a snídani?</p>
          <p class="cta__t">
            Vybrali jsme pro vás {podnikuText(PODNIKY.length)} na snídani a brunch po celém Česku. Podívejte se, kde mají právě teď otevřeno ve vašem okolí.
          </p>
          <p class="cta__tl">
            <a class="btn btn--akcent" href="/otevreno-ted/">🕘 Otevřeno teď u mě</a>
            <a class="btn btn--ghost" href="/mapa/">🗺️ Mapa podniků</a>
          </p>
          <p class="cta__mesta">
            {mestaCta.map((m) => <a class="tag" href={lokalitaUrl(m)}>{m.nazev}</a>)}
            <a class="tag" href="/podniky/">Všechny podniky</a>
          </p>
        </aside>
      </div>
    </div>
  </article>

  {
    podniky.length > 0 && (
      <section class="section section--blush">
        <div class="wrap">
          <h2>Podniky z článku</h2>
          <ul class="karty">{podniky.map((p) => <Karta p={p} />)}</ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <h2>Mohlo by vás zajímat</h2>
        <a class="btn btn--ghost" href="/blog/">Všechny články</a>
      </div>
      <ul class="karty karty--blog">{dalsi.map((x) => <BlogKarta c={x} />)}</ul>
    </div>
  </section>
</Base>

<script>
  // Zvýraznění aktuální části v obsahu podle toho, kde čtenář je
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const odkazy = new Map([...toc.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [a.hash.slice(1), a]));
    const nadpisy = [...odkazy.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const obnov = () => {
      let aktivni = nadpisy[0];
      for (const h of nadpisy) if (h.getBoundingClientRect().top < 140) aktivni = h;
      odkazy.forEach((a, id) => a.classList.toggle('aktivni', id === aktivni?.id));
    };
    addEventListener('scroll', obnov, { passive: true });
    obnov();
  }
</script>

<style>
  .clanek-text :global(.recept) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem 1.5rem;
    border-radius: var(--radius);
    background: var(--blush);
    border: 1px solid var(--line);
  }
  .clanek-text :global(.recept h2) {
    margin-top: 0;
  }
  .clanek-text :global(.recept__info) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .clanek-text :global(.recept__info li) {
    margin: 0;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .clanek-text :global(.recept__postup li) {
    margin-bottom: 0.5rem;
  }
  .cta {
    margin: 2.5rem 0 0;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius);
    background: var(--blush);
    border: 1px solid var(--line);
  }
  .cta__h {
    margin: 0 0 0.4rem;
    font: 700 1.2rem/1.3 var(--f-display);
    color: var(--brown-dark);
  }
  .cta__t {
    margin: 0 0 1rem;
    max-width: none;
  }
  .cta__tl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
  }
  .cta__mesta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }
  .cta__mesta .tag {
    background: #fff;
  }
  .telo {
    display: grid;
    grid-template-columns: 15rem minmax(0, 44rem);
    justify-content: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .bok__in {
    position: sticky;
    top: 90px;
    padding-top: clamp(32px, 5vw, 56px);
  }
  .toc__h {
    margin: 0 0 0.75rem;
    font: 600 0.72rem/1.3 var(--f-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }
  .toc ol,
  .toc-m ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc ol {
    border-left: 2px solid var(--line);
  }
  .toc li a {
    display: block;
    margin-left: -2px;
    padding: 0.35rem 0 0.35rem 1rem;
    border-left: 2px solid transparent;
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .toc li a:hover {
    color: var(--brown-dark);
  }
  .toc li a.aktivni {
    border-left-color: var(--accent);
    color: var(--brown-dark);
    font-weight: 600;
  }
  .ctete {
    margin-top: 2rem;
  }
  .ctete ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ctete li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .ctete a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .ctete a:hover {
    color: var(--accent-deep);
  }
  .toc-m {
    display: none;
  }
  .clanek-text :global(h2) {
    scroll-margin-top: 90px;
  }
  @media (max-width: 960px) {
    .telo {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .bok {
      order: 2;
    }
    .bok__in {
      position: static;
      padding-top: 0;
      padding-bottom: 2rem;
    }
    .toc {
      display: none;
    }
    .ctete {
      margin-top: 0;
      padding: 1.25rem 1.5rem;
      border-left: 3px solid var(--accent);
      background: var(--blush);
      border-radius: 0 var(--radius) var(--radius) 0;
    }
    .toc-m {
      display: block;
      margin-top: clamp(24px, 4vw, 40px);
      padding: 0.9rem 1.2rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--blush);
    }
    .toc-m summary {
      cursor: pointer;
      font: 600 0.95rem var(--f-display);
      color: var(--brown-dark);
    }
    .toc-m ol {
      margin-top: 0.6rem;
    }
    .toc-m li a {
      display: block;
      padding: 0.35rem 0;
      color: var(--ink-soft);
      text-decoration: none;
      font-size: 0.92rem;
    }
  }
  .clanek-head {
    padding-block: clamp(28px, 5vw, 56px) clamp(20px, 3vw, 32px);
  }
  .clanek-head h1 {
    max-width: 22ch;
  }
  .meta {
    margin: 0;
    font-size: 0.92rem;
  }
  .meta a {
    color: var(--accent-deep);
  }
  .clanek-foto {
    aspect-ratio: 16 / 8;
    border-radius: 24px;
    overflow: hidden;
    background: var(--cream);
  }
  .clanek-text {
    padding-block: clamp(32px, 5vw, 56px);
    margin-inline: auto;
    max-width: 44rem;
  }
  .karty--blog {
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
  }
</style>
