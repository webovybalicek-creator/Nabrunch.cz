---
import Base from '../layouts/Base.astro';
import Slider from '../components/Slider.astro';
import Hledani from '../components/Hledani.astro';
import Vypis from '../components/Vypis.astro';
import BlogKarta from '../components/BlogKarta.astro';
import Foto from '../components/Foto.astro';
import { SITE } from '../lib/config';
import { PODNIKY, doporucene, nejnovejsi, mesta, lokalitaUrl, TEMATA, temaUrl, podnikyTematu, podnikuText, velky, url } from '../lib/data';
import { clanky, kategorie } from '../lib/blog';
import { oknaData, vyber, obdobiDne, OBDOBI_NADPIS, type SezonniClanek } from '../lib/sezona';

const srdcovky = doporucene();
const nove = nejnovejsi(12);
// Ve výpisu „Všechny podniky“ abecedně (srdcovky a novinky jsou v sekcích nad ním)
const vse = [...PODNIKY].sort((a, b) => a.nazev.localeCompare(b.nazev, 'cs'));
const topMesta = [...mesta()].sort((a, b) => b.podniky.length - a.podniky.length);
// Brunch tipy: sezónní výběr (logika v src/lib/sezona.ts). Do HTML jde „zásobník“ kandidátů,
// viditelných je 6 podle data buildu; skript níže výběr přepočítá podle dnešního data v prohlížeči.
const rok = new Date().getFullYear();
// Sváteční oddíl („Vánoce a Silvestr“): všechny články o Vánocích, Silvestru a Novém roce, jejichž sezóna právě běží
const dnesIso = new Date().toISOString().slice(0, 10);
const SVATKY_RE = /vánoc|vánoč|silvest|nový rok|novoroč/i;
const svatky = (await clanky())
  .filter((c) => c.data.naHp !== false && c.data.image && SVATKY_RE.test(c.data.title))
  .map((c) => ({ c, okno: oknaData(c.data.sezona, rok - 1, rok + 1).find(([a, b]) => a <= dnesIso && dnesIso <= b) }))
  .filter((x) => x.okno)
  .sort((a, b) => (/silvest|nový rok|novoroč/i.test(a.c.data.title) ? 1 : 0) - (/silvest|nový rok|novoroč/i.test(b.c.data.title) ? 1 : 0) || a.c.data.date.getTime() - b.c.data.date.getTime())
  .map((x) => x.c);
const vsechny = (await clanky()).filter((c) => c.data.naHp !== false && !svatky.some((s) => s.id === c.id));
const TIPU = 5;
const zasobnik = [
  ...vsechny.filter((c) => c.data.sezona?.length || c.data.obdobi?.length),
  ...vsechny.filter((c) => !c.data.sezona?.length && !c.data.obdobi?.length).slice(0, 12),
];
const sezonni: SezonniClanek[] = zasobnik.map((c) => ({
  okna: oknaData(c.data.sezona, rok - 1, rok + 2),
  sezonni: !!c.data.sezona?.length,
  obdobi: c.data.obdobi ?? [],
  kat: kategorie(c),
  datum: c.data.date.toISOString().slice(0, 10),
}));
const dnes = new Date();
const poradi = vyber(sezonni, dnes, TIPU);
const tipy = [...poradi, ...zasobnik.map((_, i) => i).filter((i) => !poradi.includes(i))].map((i) => ({
  c: zasobnik[i],
  data: sezonni[i],
  viditelny: poradi.includes(i),
}));
const tipyNadpis = OBDOBI_NADPIS[obdobiDne(dnes)];
// Úvod: při každém načtení náhodná srdcovka (vybírá skript v prohlížeči), s proklikem na detail.
// Ukazuje se jen jídlo: kde hlavní fotka jídlo není, bere se fotka z galerie; podnik bez fotky jídla se v úvodu neukazuje.
const UVOD_JINA_FOTKA: Record<string, string> = {
  'kafe-doma-litomerice': '/wp-content/uploads/2025/03/kafedoma4.jpg',
  'kupkafe-opava': '/wp-content/uploads/2025/03/kupkafe1.jpg',
};
const UVOD_BEZ_JIDLA = ['kocici-kavarna-praha'];
const uvodni = srdcovky
  .filter((p) => !UVOD_BEZ_JIDLA.includes(p.slug))
  .map((p) => {
    const webp = velky(UVOD_JINA_FOTKA[p.slug] ?? p.foto);
    return { u: url(p), n: p.nazev, a: p.lokality[0] ?? '', f: webp, v: webp.replace(/\.webp$/, '.avif') };
  });
const uvodniFoto = uvodni[0];

// Dlaždice témat: největší téma jako velká dlaždice, ke každému fotka jiného podniku
const pouzite = new Set<number>();
const temataFoto = [...TEMATA]
  .map((t) => ({ t, podniky: podnikyTematu(t) }))
  .sort((a, b) => b.podniky.length - a.podniky.length)
  .map(({ t, podniky }, i) => {
    const p = podniky.find((x) => !pouzite.has(x.id)) ?? podniky[0];
    if (p) pouzite.add(p.id);
    return { t, pocet: podniky.length, foto: p?.foto, velka: i === 0 };
  });

const organizace = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organizace`,
  name: SITE.nazev,
  url: SITE.url,
  logo: `${SITE.url}/apple-touch-icon.png`,
  email: SITE.email,
  sameAs: [SITE.instagram, SITE.facebook],
  description: 'Průvodce snídaňovými a brunchovými místy v Česku. Podniky osobně ověřené redakcí, s adresou, otevírací dobou a tipy.',
};
const webLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  publisher: { '@id': `${SITE.url}/#organizace` },
  name: SITE.nazev,
  url: SITE.url,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/podniky/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const jsonLd = [organizace, webLd];
---

<Base
  title="Nabrunch.cz | Průvodce nejlepšími snídaňovými a brunchovými místy v Česku."
  description="Věříme, že snídaně a brunche nejsou jen o jídle, ale o atmosféře, zážitku a chvíli klidu. Vybíráme ty nejlepší podniky po celé České republice – od skrytých kaváren v Praze po rodinné pekárny na jižní Moravě."
  obrazek="/wp-content/uploads/2025/03/nabrunch-1.jpg"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__text">
        <h1>Víme, kam <span>naBrunch!</span></h1>
        <p class="lead">Objevte ta nejlepší místa na snídani a brunch po celé České republice.</p>
        <div class="hero__hledat"><Hledani /></div>
        <div class="hero__mesta">
          <span>Oblíbená města:</span>
          <ul aria-label="Oblíbená města">
            {topMesta.slice(0, 6).map((m) => <li><a href={lokalitaUrl(m)}>{m.nazev}</a></li>)}
          </ul>
        </div>
        <dl class="hero__cisla">
          <div><dt>{PODNIKY.length}</dt><dd>ručně vybraných podniků</dd></div>
          <div><dt>{mesta().length}</dt><dd>měst po celém Česku</dd></div>
        </dl>
      </div>
      {
        uvodniFoto && (
          <a class="hero__foto" href={uvodniFoto.u} data-uvod>
            <picture>
              <source type="image/avif" data-uvod-avif />
              <img class="foto" alt={uvodniFoto.n} data-uvod-img decoding="async" fetchpriority="high" />
            </picture>
            <noscript><img class="foto" src={uvodniFoto.f} alt={uvodniFoto.n} /></noscript>
            <span class="hero__karta">
              <span class="hero__stitek">Naše srdcovka</span>
              <strong data-uvod-nazev>{uvodniFoto.n}</strong>
              <span data-uvod-adresa>{uvodniFoto.a}</span>
            </span>
          </a>
          <script is:inline define:vars={{ uvodni }}>
            (() => {
              const p = uvodni[Math.floor(Math.random() * uvodni.length)];
              const a = document.querySelector('[data-uvod]');
              if (!p || !a) return;
              window.__uvodniPodnik = p.u;
              a.href = p.u;
              a.querySelector('[data-uvod-avif]').srcset = p.v;
              const img = a.querySelector('[data-uvod-img]');
              img.onerror = () => {
                const s = a.querySelector('source');
                if (s) { s.remove(); img.src = p.f; }
              };
              img.src = p.f;
              img.alt = p.n;
              a.querySelector('[data-uvod-nazev]').textContent = p.n;
              a.querySelector('[data-uvod-adresa]').textContent = p.a;
            })();
          </script>
        )
      }
    </div>
  </section>

  <Slider podniky={srdcovky} eyebrow="Naše srdcovky" nadpis="Doporučené podniky" odkaz={{ href: '/podniky/', text: 'Všechny podniky' }} zamichat />
  <script is:inline>
    /* Srdcovka z úvodu se ve slideru pod ním neopakuje */
    (() => {
      const u = window.__uvodniPodnik;
      const s = document.querySelector('[data-slider][data-zamichat]');
      if (!u || !s) return;
      s.querySelectorAll('a[href="' + u + '"]').forEach((a) => a.closest('li')?.remove());
    })();
  </script>

  <Slider podniky={nove} eyebrow="Nová místa, nové chutě" nadpis="Nově přidané" tmavy />

  <section class="section" id="vsechnypodniky">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Brunch podle vás</span>
          <h2>Všechny podniky</h2>
          <p class="muted">Město, chuť, atmosféra? Záleží jen na vás, co si zrovna přejete najít.</p>
        </div>
      </div>
      <Vypis podniky={vse} ld={false} />
    </div>
  </section>

  <section class="section section--blush">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Podle chuti a nálady</span>
          <h2>Na co máte dnes chuť?</h2>
        </div>
      </div>
      <ul class="temata">
        {
          temataFoto.map(({ t, pocet, foto, velka }) => (
            <li class:list={{ 'temata__velka': velka }}>
              <a href={temaUrl(t)}>
                {foto && <Foto src={foto} alt="" />}
                <span class="temata__text">
                  <strong>{t.kratce}</strong>
                  <span>{podnikuText(pocet)}</span>
                </span>
                <svg class="temata__sipka" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    svatky.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="sec-head">
            <div>
              <span class="eyebrow">Sváteční inspirace</span>
              <h2>Vánoce a Silvestr 🎄</h2>
            </div>
            <a href="/blog/recepty/" class="btn btn--ghost">Recepty</a>
          </div>
          <ul class="karty karty--blog">
            {svatky.map((c) => (
              <BlogKarta c={c} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow" data-tipy-nadpis>{tipyNadpis}</span>
          <h2>Brunch tipy</h2>
        </div>
        <a href="/blog/" class="btn btn--ghost">Všechny články</a>
      </div>
      <ul class="tipy" data-tipy={TIPU}>
        {
          tipy.map(({ c, data, viditelny }) => (
            <BlogKarta c={c} hidden={!viditelny} sezona={JSON.stringify(data)} />
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pridej-sekce" slot="za-newsletterem">
    <div class="wrap">
      <div class="pridej">
        <div>
          <span class="eyebrow">Pro podniky</span>
          <h2>Přidejte svůj podnik</h2>
          <p>Vaříte a pečete srdcem? Servírujete brunch s láskou? Dejte nám o sobě vědět, ať se do vašeho brunche lidé zamilují hned po prvním soustu.</p>
        </div>
        <a href="/pridat-podnik/" class="btn btn--akcent">Přidat podnik</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Úvod: světle růžové pozadí (sekce se pak střídají: růžová, bílá, růžová…), text s vyhledáváním vlevo a jedna fotka vpravo; pod průhlednou hlavičkou (70 px) */
  .hero {
    position: relative;
    z-index: 2; /* našeptávač hledání přesahuje přes další sekci */
    padding-block: calc(70px + clamp(28px, 5vw, 56px)) clamp(40px, 6vw, 72px);
    background: var(--blush);
  }
  .hero__in {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 5.4vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .hero h1 span {
    color: var(--accent);
  }
  .hero .lead {
    max-width: 32rem;
  }
  .hero__hledat {
    margin: 1.75rem 0 1rem;
  }
  .hero__mesta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.1rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .hero__mesta ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.1rem;
  }
  .hero__mesta a {
    display: inline-block;
    padding: 0.6rem 0;
    font-weight: 600;
    color: var(--brown-dark);
  }
  .hero__cisla {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .hero__cisla dt {
    font: 600 1.9rem/1.1 var(--f-display);
    color: var(--brown-dark);
  }
  .hero__cisla dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .hero__foto {
    position: relative;
    min-height: clamp(360px, 38vw, 480px);
    border-radius: 24px;
    overflow: hidden;
    background: var(--cream);
  }
  .hero__foto {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .hero__foto .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease-out;
  }
  .hero__karta {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    max-width: calc(100% - 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.85rem 1.1rem;
    border-radius: 16px;
    background: #fff;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .hero__karta strong {
    font: 600 1.1rem/1.25 var(--f-display);
    color: var(--brown-dark);
  }
  .hero__stitek {
    font: 600 0.7rem/1.3 var(--f-display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brown);
  }
  @media (hover: hover) {
    .hero__foto:hover {
      color: inherit;
    }
    .hero__foto:hover .foto {
      transform: scale(1.03);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__foto .foto {
      transition: none;
    }
  }
  @media (max-width: 860px) {
    .hero__in {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__foto {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }
  }
  .temata {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(170px, auto);
    gap: 0.9rem;
  }
  .temata__velka {
    grid-row: span 2;
  }
  .temata a {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    height: 100%;
    min-height: 170px;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--brown-dark);
    color: #fff;
    text-decoration: none;
  }
  .temata a :global(.foto) {
    position: absolute;
    inset: 0;
    transition: transform 0.3s ease-out;
  }
  .temata a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(43, 33, 28, 0.86) 0%, rgba(43, 33, 28, 0.35) 45%, rgba(43, 33, 28, 0.05) 75%);
  }
  .temata__text,
  .temata__sipka {
    position: relative;
    z-index: 2;
  }
  .temata__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-size: 0.82rem;
    font-weight: 500;
  }
  .temata strong {
    font: 600 1.15rem/1.15 var(--f-display);
  }
  .temata__velka strong {
    font-size: 1.85rem;
  }
  .temata__sipka {
    flex: none;
  }
  @media (hover: hover) {
    .temata a:hover {
      color: #fff;
    }
    .temata a:hover :global(.foto) {
      transform: scale(1.04);
    }
  }
  @media (max-width: 900px) {
    .temata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(140px, auto);
    }
    .temata__velka {
      grid-row: auto;
      grid-column: span 2;
    }
    .temata a {
      min-height: 140px;
    }
    .temata li:not(.temata__velka) strong {
      font-size: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .temata a :global(.foto) {
      transition: none;
    }
  }
  /* Přidej podnik: hned pod newsletterem na stejném krémovém pozadí */
  .pridej-sekce {
    background: #f7834f;
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .pridej {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding: clamp(28px, 5vw, 56px);
    background: var(--brown-dark);
    border-radius: 28px;
    color: rgb(255 255 255 / 0.85);
  }
  .pridej h2 {
    color: #fff;
  }
  .pridej p {
    margin: 0;
  }
</style>

<style is:global>
  /* Brunch tipy na úvodní stránce: první viditelný článek velký s fotkou, další jako řádky */
  .tipy {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    column-gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .tipy.tipy.tipy > .bk {
    grid-column: 2;
    border-bottom: 1px solid var(--line);
  }
  .tipy.tipy.tipy > .bk a {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    column-gap: 1.1rem;
    align-items: center;
    padding: 1.1rem 0;
  }
  .tipy.tipy.tipy > .bk .bk__foto {
    grid-row: span 2;
    width: 112px;
    aspect-ratio: 1;
    border-radius: 14px;
  }
  .tipy.tipy.tipy > .bk .bk__kat {
    margin-top: 0;
    align-self: end;
  }
  .tipy.tipy.tipy > .bk h3 {
    margin: 0.3rem 0 0;
    align-self: start;
  }
  .tipy.tipy.tipy > .bk p {
    display: none;
  }
  .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) {
    grid-column: 1;
    grid-row: 1 / span 4;
    border-bottom: 0;
  }
  .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    height: 100%;
    min-height: 420px;
    padding: 1.75rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--brown-dark);
    color: #fff;
  }
  .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) .bk__foto {
    position: absolute;
    inset: 0;
    width: auto;
    aspect-ratio: auto;
    border-radius: 0;
  }
  .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) .bk__foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(43, 33, 28, 0.9) 0%, rgba(43, 33, 28, 0.45) 50%, rgba(43, 33, 28, 0.05) 80%);
  }
  .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) .bk__kat,
  .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) h3,
  .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) p {
    position: relative;
    align-self: auto;
    color: #fff;
  }
  .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) h3 {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.15;
    margin: 0.5rem 0 0.6rem;
  }
  .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) p {
    display: block;
    max-width: 34rem;
    font-size: 0.95rem;
  }
  /* Řádky vpravo lícují s horní a dolní hranou velké dlaždice */
  @media (min-width: 801px) {
    .tipy.tipy.tipy > .bk:nth-child(2 of :not([hidden])) a {
      padding-top: 0;
    }
    .tipy.tipy.tipy > .bk:nth-last-child(1 of :not([hidden])) {
      border-bottom: 0;
    }
    .tipy.tipy.tipy > .bk:nth-last-child(1 of :not([hidden])) a {
      padding-bottom: 0;
    }
  }
  @media (max-width: 800px) {
    .tipy {
      grid-template-columns: minmax(0, 1fr);
    }
    .tipy.tipy.tipy > .bk,
    .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) {
      grid-column: 1;
      grid-row: auto;
    }
    .tipy.tipy.tipy > .bk:nth-child(1 of :not([hidden])) a {
      min-height: 320px;
    }
  }
</style>

<script>
  import { vyber, obdobiDne, OBDOBI_NADPIS, type SezonniClanek } from '../lib/sezona';

  // Přepočet sezónních tipů podle dnešního data (HTML bylo sestaveno v den buildu)
  const seznam = document.querySelector<HTMLUListElement>('[data-tipy]');
  if (seznam) {
    const karty = [...seznam.querySelectorAll<HTMLLIElement>(':scope > li[data-sezona]')];
    const data = karty.map((k) => JSON.parse(k.dataset.sezona!) as SezonniClanek);
    const dnes = new Date();
    const poradi = vyber(data, dnes, Number(seznam.dataset.tipy) || 6);
    karty.forEach((k) => (k.hidden = true));
    for (const i of poradi) {
      karty[i].hidden = false;
      seznam.appendChild(karty[i]);
    }
    const nadpis = document.querySelector('[data-tipy-nadpis]');
    if (nadpis) nadpis.textContent = OBDOBI_NADPIS[obdobiDne(dnes)];
  }
</script>
