---
import Base from '../layouts/Base.astro';
import Slider from '../components/Slider.astro';
import Hledani from '../components/Hledani.astro';
import Vypis from '../components/Vypis.astro';
import BlogKarta from '../components/BlogKarta.astro';
import Foto from '../components/Foto.astro';
import { SITE } from '../lib/config';
import { PODNIKY, doporucene, nejnovejsi, mesta, lokalitaUrl, TEMATA, temaUrl, podnikyTematu, podnikuText } from '../lib/data';
import { clanky } from '../lib/blog';

const srdcovky = doporucene();
const nove = nejnovejsi(12);
// Ve výpisu „Všechny podniky“ abecedně (srdcovky a novinky jsou v sekcích nad ním)
const vse = [...PODNIKY].sort((a, b) => a.nazev.localeCompare(b.nazev, 'cs'));
const topMesta = [...mesta()].sort((a, b) => b.podniky.length - a.podniky.length);
const tipy = (await clanky()).slice(0, 6);
const kolaz = srdcovky.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.nazev,
  url: SITE.url,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/podniky/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Base
  title="Nabrunch.cz | Průvodce nejlepšími snídaňovými a brunchovými místy v Česku."
  description="Věříme, že snídaně a brunche nejsou jen o jídle, ale o atmosféře, zážitku a chvíli klidu. Vybíráme ty nejlepší podniky po celé České republice – od skrytých kaváren v Praze po rodinné pekárny na jižní Moravě."
  obrazek="/wp-content/uploads/2025/03/nabrunch-1.jpg"
  jsonLd={jsonLd}
>
  <section class="hero" data-hero>
    <canvas class="hero__smouha" data-smouha aria-hidden="true"></canvas>
    <div class="wrap hero__in">
      <div class="hero__text">
        <span class="eyebrow">nabrunch.cz</span>
        <h1>Víme, kam <span>naBrunch!</span></h1>
        <p class="lead">Objev ta nejlepší místa na snídani a brunch po celé České republice. Ručně vybraných {podnikuText(PODNIKY.length)} v {mesta().length} městech.</p>
        <div class="hero__hledat"><Hledani /></div>
        <ul class="hero__mesta" aria-label="Oblíbená města">
          {topMesta.slice(0, 6).map((m) => <li><a class="tag" href={lokalitaUrl(m)}>{m.nazev}</a></li>)}
          <li><a class="tag" href="/mapa/">🗺️ Mapa podniků</a></li>
        </ul>
      </div>
      <div class="hero__kolaz" aria-hidden="true">
        {kolaz.map((p, i) => <div class={`hero__f hero__f--${i}`}><Foto src={p.foto} alt="" eager={i === 0} /></div>)}
      </div>
    </div>
  </section>

  <Slider podniky={srdcovky} eyebrow="Naše srdcovky" nadpis="Doporučené podniky" odkaz={{ href: '/podniky/', text: 'Všechny podniky' }} />

  <Slider podniky={nove} eyebrow="Nová místa, nové chutě" nadpis="Nově přidané" tmavy />

  <section class="section" id="vsechnypodniky">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Brunch podle tebe</span>
          <h2>Všechny podniky</h2>
          <p class="muted">Město, chuť, atmosféra? Záleží jen na tobě, co si zrovna přeješ najít.</p>
        </div>
      </div>
      <Vypis podniky={vse} />
    </div>
  </section>

  <section class="section section--blush">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Podle chuti a nálady</span>
          <h2>Na co máš dnes chuť?</h2>
        </div>
      </div>
      <ul class="temata">
        {
          TEMATA.map((t) => (
            <li>
              <a href={temaUrl(t)}>
                <span class="temata__e" aria-hidden="true">{t.emoji}</span>
                <strong>{t.kratce}</strong>
                <span class="muted">{podnikuText(podnikyTematu(t).length)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--blush">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Co je nového</span>
          <h2>Brunch tipy</h2>
        </div>
        <a href="/blog/" class="btn btn--ghost">Všechny články</a>
      </div>
      <ul class="karty karty--blog">{tipy.map((c) => <BlogKarta c={c} />)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap pridej">
      <div>
        <span class="eyebrow">Pro podniky</span>
        <h2>Přidej svůj podnik</h2>
        <p>Vaříte a pečete srdcem? Servírujete brunch s láskou? Dejte nám o sobě vědět, ať se do vašeho brunche lidé zamilují hned po prvním soustu.</p>
      </div>
      <a href="/pridat-podnik/" class="btn btn--akcent">Přidat podnik</a>
    </div>
  </section>
</Base>

<script>
  import { smouha } from '../scripts/smouha';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const platno = document.querySelector<HTMLCanvasElement>('[data-smouha]');
  if (hero && platno) smouha(platno, hero);
</script>

<style>
  /* Úvod: jemný broskvovo-růžový gradient, pod průhlednou hlavičkou (70 px) */
  .hero {
    position: relative;
    isolation: isolate;
    z-index: 2; /* našeptávač hledání přesahuje přes další sekci */
    padding-block: calc(70px + clamp(32px, 6vw, 72px)) clamp(40px, 7vw, 88px);
    overflow: visible;
    background:
      radial-gradient(60% 70% at 88% 18%, rgb(255 190 160 / 0.55), transparent 70%),
      radial-gradient(55% 60% at 8% 92%, rgb(255 178 186 / 0.45), transparent 70%),
      radial-gradient(40% 45% at 45% 40%, rgb(255 228 205 / 0.7), transparent 75%),
      linear-gradient(160deg, #fff7f2 0%, #ffeee7 45%, #ffe9ea 100%);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent, rgb(255 255 255 / 0.6));
    z-index: -1;
    pointer-events: none;
  }
  .hero__smouha {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    filter: blur(6px);
    mix-blend-mode: multiply;
  }
  .hero__in {
    position: relative;
    z-index: 1;
  }
  .hero__in {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.2rem);
  }
  .hero h1 span {
    color: var(--accent);
  }
  .hero__hledat {
    margin: 1.75rem 0 1.25rem;
  }
  .hero__mesta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .hero__mesta .tag {
    background: #fff;
    font-size: 0.85rem;
    padding: 0.4em 0.9em;
  }
  .hero__kolaz {
    position: relative;
    aspect-ratio: 1 / 1;
  }
  .hero__f {
    position: absolute;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 18px 40px rgb(83 42 25 / 0.16);
    background: var(--cream);
  }
  .hero__f--0 {
    inset: 0 22% 22% 0;
  }
  .hero__f--1 {
    width: 46%;
    aspect-ratio: 4 / 5;
    right: 0;
    top: 12%;
    border: 6px solid #fff;
  }
  .hero__f--2 {
    width: 42%;
    aspect-ratio: 1;
    left: 22%;
    bottom: 0;
    border: 6px solid #fff;
  }
  @media (max-width: 860px) {
    .hero__in {
      grid-template-columns: 1fr;
    }
    .hero__kolaz {
      display: none;
    }
  }
  .temata {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(14rem, 100%), 1fr));
    gap: 0.9rem;
  }
  .temata a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.9rem;
    align-items: center;
    padding: 1.1rem 1.25rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .temata a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    color: inherit;
  }
  .temata__e {
    grid-row: span 2;
    font-size: 1.8rem;
  }
  .temata strong {
    font-family: var(--f-display);
    color: var(--brown-dark);
  }
  .temata .muted {
    font-size: 0.85rem;
  }
  .karty--blog {
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
  }
  .pridej {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding: clamp(28px, 5vw, 56px);
    background: var(--brown-dark);
    border-radius: 28px;
    color: rgb(255 255 255 / 0.85);
  }
  .pridej h2 {
    color: #fff;
  }
  .pridej p {
    margin: 0;
  }
</style>
