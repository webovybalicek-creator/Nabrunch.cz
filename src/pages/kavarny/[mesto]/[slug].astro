---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Mapa from '../../../components/Mapa.astro';
import Karta from '../../../components/Karta.astro';
import KavarnaKarta from '../../../components/KavarnaKarta.astro';
import Neovereno from '../../../components/Neovereno.astro';
import Hodnoceni from '../../../components/Hodnoceni.astro';
import { souhrnHodnoceni } from '../../../lib/hodnoceni';
import { SITE } from '../../../lib/config';
import { kmText } from '../../../lib/data';
import { DNY, denText, schemaSpec } from '../../../lib/oteviraci-doba';
import {
  KAVARNY,
  ZDROJ,
  kavarnaUrl,
  mestoKavarenUrl,
  adresaKavarny,
  tydenKavarny,
  popisKavarny,
  metaKavarny,
  indexovatKavarnu,
  overeneVOkoli,
  kavarnyVOkoli,
  nabizi,
  type Kavarna,
} from '../../../lib/kavarny';

export function getStaticPaths() {
  return KAVARNY.map((k) => ({ params: { mesto: k.mestoSlug, slug: k.slug }, props: { k } }));
}
const { k } = Astro.props as { k: Kavarna };
const t = tydenKavarny(k);
const meta = metaKavarny(k);
const popis = popisKavarny(k);
const overene = overeneVOkoli(k, 3);
const okoli = kavarnyVOkoli(k, 6);
const n = nabizi(k);
const adr = adresaKavarny(k);
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const web = k.web && (/^https?:\/\//.test(k.web) ? k.web : `https://${k.web}`);
const ig = k.instagram && (/^https?:/.test(k.instagram) ? k.instagram : `https://www.instagram.com/${k.instagram.replace(/^@/, '')}/`);
const fb = k.facebook && (/^https?:/.test(k.facebook) ? k.facebook : `https://www.facebook.com/${k.facebook}`);
const navigace = `https://www.google.com/maps/dir/?api=1&destination=${k.lat},${k.lon}`;

const ano = (v: boolean | null) => (v === true ? 'Ano' : v === false ? 'Ne' : undefined);
const parametry = [
  ['Wi-Fi', ano(k.vlastnosti.wifi)],
  ['Venkovní posezení', ano(k.vlastnosti.zahradka)],
  ['Se psem', ano(k.vlastnosti.psi)],
  ['Bezbariérový vstup', ano(k.vlastnosti.bezbarierove)],
  ['Platba kartou', ano(k.vlastnosti.karta)],
  ['Káva s sebou', ano(k.vlastnosti.sSebou)],
].filter(([, v]) => v) as [string, string][];
const stitky = [
  n.brunch ? '🥞 Brunch' : n.snidane ? '🍳 Snídaně' : '',
  n.vyberovaKava ? '☕ Výběrová káva' : '',
  n.prazirna ? 'Pražírna' : '',
  n.pekarna ? '🥐 Pečivo' : '',
  n.dorty ? '🍰 Dorty' : '',
  n.vegan ? '🌱 Vegan' : '',
  n.bezlepek ? 'Bezlepkové' : '',
].filter(Boolean);

const hod = (await souhrnHodnoceni())[k.id];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  name: k.nazev,
  ...(hod && hod[1] > 0
    ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: hod[0], ratingCount: hod[1], bestRating: 5, worstRating: 1 } }
    : {}),
  url: new URL(kavarnaUrl(k), SITE.url).href,
  address: { '@type': 'PostalAddress', streetAddress: k.ulice ?? undefined, postalCode: k.psc ?? undefined, addressLocality: k.mesto, addressCountry: 'CZ' },
  geo: { '@type': 'GeoCoordinates', latitude: k.lat, longitude: k.lon },
  ...(k.telefon ? { telephone: k.telefon } : {}),
  ...(web || ig ? { sameAs: [web, ig].filter(Boolean) } : {}),
  ...(t ? { openingHoursSpecification: schemaSpec(t) } : {}),
};
---

<Base title={meta.title} description={meta.description} jsonLd={jsonLd} noindex={!indexovatKavarnu(k)}>
  <script type="application/json" id="kavarna-zaklad" set:html={JSON.stringify({
    tyden: t,
    telefon: k.telefon,
    email: k.email,
    web,
    instagram: ig,
    facebook: fb,
    rezervace: k.rezervace,
    popis: k.popisMajitele,
    vlastnosti: [
      ...(['wifi', 'zahradka', 'psi', 'bezbarierove', 'karta'] as const).filter((x) => k.vlastnosti[x]),
      ...(n.snidane ? ['snidane'] : []), ...(n.brunch ? ['brunch'] : []), ...(n.vyberovaKava ? ['vyberovaKava'] : []),
      ...(n.pekarna ? ['pekarna'] : []), ...(n.dorty ? ['dorty'] : []), ...(n.vegan ? ['vegan'] : []), ...(n.bezlepek ? ['bezlepek'] : []), ...(n.deti ? ['deti'] : []),
    ],
  }).replace(/</g, '\\u003c')} />
  <article>
    <header class="page-head">
      <div class="wrap">
        <Breadcrumb polozky={[{ nazev: 'Kavárny', url: '/kavarny/' }, { nazev: k.mesto, url: mestoKavarenUrl(k.mestoSlug) }, { nazev: k.nazev }]} />
        <p class="kd__typ"><span class="tag">☕ Kavárna</span> <Neovereno overeno={k.overeno} /></p>
        <h1>{k.nazev}</h1>
        <p class="kd__adr">📍 {adr || k.mesto}</p>
        <a class="kd__hod" href="#hodnoceni">
          <span class="hod-mini" data-hod-id={k.id}><span class="hv" style="--p:0%"></span><span class="hod-mini__nic">Zatím bez hodnocení – ohodnoťte jako první</span></span>
        </a>
        {t && <p class="kd__stav" data-oh={JSON.stringify(t)}><span class="stav"></span></p>}
        {stitky.length > 0 && <p class="kd__tagy">{stitky.map((s) => <span class="tag tag--zelena">{s}</span>)}</p>}
        <p class="kd__akce">
          <a class="btn btn--akcent" href={navigace} rel="noopener" target="_blank">Navigovat</a>
          {k.rezervace && <a class="btn btn--ghost" href={k.rezervace} rel="noopener nofollow" target="_blank">Rezervovat</a>}
          {web && <a class="btn btn--ghost" href={web} rel="noopener nofollow" target="_blank">Web</a>}
          {k.telefon && <a class="btn btn--ghost" href={`tel:${k.telefon.replace(/\s/g, '')}`}>Zavolat</a>}
        </p>
      </div>
    </header>

    {
      k.fotky && k.fotky.length > 0 && (
        <div class="wrap">
          <ul class="kd__fotky">
            {k.fotky.map((f, i) => (
              <li>
                <a href={`${f}_1400.webp`} target="_blank" rel="noopener">
                  <img src={`${f}_640.webp`} alt={`${k.nazev} – fotka ${i + 1}`} loading={i ? 'lazy' : 'eager'} decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="wrap kd__grid">
      <div>
        {
          k.popisMajitele && (
            <blockquote class="kd__majitel">
              <p>{k.popisMajitele}</p>
              <footer>— slovo majitele</footer>
            </blockquote>
          )
        }
        <div class="prose">
          {popis.map((p) => <p>{p}</p>)}
        </div>
        <Neovereno velky overeno={k.overeno} />
        {
          !k.overeno && (
            <details class="kd__claim" id="majitel">
              <summary>Jste majitel? Převezměte správu kavárny zdarma</summary>
              <p class="muted">Po ověření upravíte otevírací dobu, kontakty, popis, fotky a co nabízíte. Pokud e-mail sedí s kavárnou (je v jejích údajích, na doméně jejího webu nebo uvedený na webu), přístup dostanete hned. Jinak ho ověříme ručně.</p>
              <form data-claim data-id={k.id}>
                <label>Jméno<input name="jmeno" required maxlength="80" autocomplete="name" /></label>
                <label>E-mail<input name="email" type="email" required maxlength="120" autocomplete="email" /></label>
                <label>Telefon <span class="muted">(nepovinné)</span><input name="telefon" type="tel" maxlength="30" autocomplete="tel" /></label>
                <input name="web2" tabindex="-1" autocomplete="off" class="kd__past" aria-hidden="true" />
                <button class="btn btn--akcent" type="submit">Získat přístup</button>
                <p class="kd__claim-stav" data-claim-stav role="status"></p>
              </form>
            </details>
          )
        }
        <Hodnoceni id={k.id} url={kavarnaUrl(k)} nazev={k.nazev} ldVHtml={!!(hod && hod[1] > 0)} />
        {
          overene.length > 0 && (
            <section class="kd__overene">
              <h2>Ověřený brunch v okolí</h2>
              <p class="muted">Tyhle podniky jsme navštívili osobně a víme, že tu snídaně a brunch stojí za to.</p>
              <ul class="karty">{overene.map(({ p }) => <Karta p={p} />)}</ul>
              <p class="muted mala">Vzdušnou čarou: {overene.map(({ p, km }) => `${p.nazev} ${kmText(km)}`).join(' · ')}</p>
            </section>
          )
        }
      </div>
      <aside class="info">
        {
          t && (
            <section>
              <h2>Otevírací doba</h2>
              <table class="kd__doba">
                {DNY.map((d, i) => (
                  <tr>
                    <th>{d}</th>
                    <td>{denText(t[i])}</td>
                  </tr>
                ))}
              </table>
            </section>
          )
        }
        <section>
          <h2>Kontakt</h2>
          <dl>
            <dt>Adresa</dt>
            <dd>{adr || k.mesto}</dd>
            {k.telefon && (<><dt>Telefon</dt><dd><a href={`tel:${k.telefon.replace(/\s/g, '')}`}>{k.telefon}</a></dd></>)}
            {web && (<><dt>Web</dt><dd><a href={web} rel="noopener nofollow" target="_blank">{host(web)}</a></dd></>)}
            {ig && (<><dt>Instagram</dt><dd><a href={ig} rel="noopener nofollow" target="_blank">{host(ig).replace('instagram.com/', '@')}</a></dd></>)}
            {fb && (<><dt>Facebook</dt><dd><a href={fb} rel="noopener nofollow" target="_blank">Facebook</a></dd></>)}
          </dl>
        </section>
        {
          parametry.length > 0 && (
            <section>
              <h2>Dobré vědět</h2>
              <dl>
                {parametry.map(([a, b]) => (
                  <>
                    <dt>{a}</dt>
                    <dd>{b}</dd>
                  </>
                ))}
              </dl>
            </section>
          )
        }
        <Mapa podniky={[]} body={[[k.lat, k.lon, k.nazev, kavarnaUrl(k), adr, 2]]} popis={`Poloha kavárny ${k.nazev}`} />
        <p class="muted mala">Zdroj údajů: {ZDROJ}{k.zWebu && Object.keys(k.zWebu).length ? ', web kavárny' : ''}.</p>
      </aside>
    </div>

    {
      okoli.length > 0 && (
        <section class="section section--blush">
          <div class="wrap">
            <div class="sec-head">
              <h2>Další kavárny poblíž</h2>
              <a class="btn btn--ghost" href={mestoKavarenUrl(k.mestoSlug)}>Všechny kavárny: {k.mesto}</a>
            </div>
            <ul class="kk-mrizka">{okoli.map(({ k: o, km }) => <KavarnaKarta k={o} km={kmText(km)} />)}</ul>
          </div>
        </section>
      )
    }
  </article>
</Base>

<script>
  import { aplikujStav } from '../../../scripts/stav';
  aplikujStav();
  // Odkaz „převzít správu“ (#majitel) rozbalí formulář
  const otevriClaim = () => {
    if (location.hash === '#majitel') document.querySelector<HTMLDetailsElement>('#majitel')?.setAttribute('open', '');
  };
  otevriClaim();
  window.addEventListener('hashchange', otevriClaim);
  document.querySelectorAll<HTMLFormElement>('[data-claim]').forEach((f) =>
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const stav = f.querySelector<HTMLElement>('[data-claim-stav]')!;
      const btn = f.querySelector('button')!;
      btn.disabled = true;
      stav.textContent = 'Ověřuji…';
      const fd = new FormData(f);
      fd.set('akce', 'zadost');
      fd.set('id', f.dataset.id!);
      try {
        const r = await (await fetch('/api/kavarna.php', { method: 'POST', body: fd })).json();
        if (!r.ok) throw new Error(r.chyba || 'Nepodařilo se odeslat.');
        stav.textContent = r.hned
          ? 'Hotovo! Poslali jsme vám na e-mail odkaz pro úpravu kavárny.'
          : 'Děkujeme! E-mail se nám nepodařilo spárovat s kavárnou automaticky, ověříme ho ručně a ozveme se do 2 pracovních dnů.';
        f.querySelectorAll('input').forEach((i) => (i.disabled = true));
      } catch (err) {
        stav.textContent = (err as Error).message;
        btn.disabled = false;
      }
    }),
  );
</script>

<style>
  .kd__typ {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0 0 0.6rem;
  }
  .kd__hod {
    display: inline-block;
    margin: -0.35rem 0 0.75rem;
    text-decoration: none;
  }
  .kd__hod .hod-mini {
    font-size: 0.9rem;
  }
  .kd__adr {
    margin: 0 0 0.4rem;
    color: var(--ink-soft);
  }
  .kd__stav {
    margin: 0 0 0.75rem;
    font-weight: 600;
  }
  .kd__stav :global([data-stav='open']) {
    color: var(--green);
  }
  .kd__stav :global([data-stav='closed']) {
    color: var(--accent-deep);
  }
  .kd__tagy,
  .kd__akce {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0 0 0.9rem;
  }
  .kd__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 2.5rem;
    padding-block: 1rem 3rem;
  }
  .kd__fotky {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(14rem, 22rem);
    gap: 0.6rem;
    overflow-x: auto;
  }
  .kd__fotky img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 14px;
    display: block;
  }
  .kd__majitel {
    margin: 0 0 1.5rem;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--accent);
    background: var(--blush);
    border-radius: 0 14px 14px 0;
  }
  .kd__majitel p {
    margin: 0 0 0.4rem;
    white-space: pre-line;
  }
  .kd__majitel footer {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .kd__claim {
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    max-width: 46rem;
  }
  .kd__claim summary {
    cursor: pointer;
    font-weight: 600;
  }
  .kd__claim form {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
  .kd__claim label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.9rem;
  }
  .kd__claim input {
    font: inherit;
    font-size: 16px;
    padding: 0.55em 0.8em;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .kd__claim .btn {
    justify-self: start;
  }
  .kd__past {
    position: absolute;
    left: -9999px;
  }
  .kd__overene {
    margin-top: 2.5rem;
  }
  .kd__overene .karty {
    grid-template-columns: repeat(auto-fill, minmax(min(14rem, 100%), 1fr));
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .info h2 {
    font-size: 1.15rem;
    margin: 0 0 0.6rem;
  }
  .info dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    margin: 0;
  }
  .info dt {
    color: var(--ink-soft);
  }
  .info dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .kd__doba {
    border-collapse: collapse;
    width: 100%;
  }
  .kd__doba th,
  .kd__doba td {
    text-align: left;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 400;
  }
  .kd__doba th {
    color: var(--ink-soft);
    width: 40%;
  }
  .mala {
    font-size: 0.82rem;
  }
  @media (max-width: 820px) {
    .kd__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
