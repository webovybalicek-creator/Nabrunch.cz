  }
  .ted__mesto {
    flex: 0 1 16rem;
  }
  .ted__mesto select {
    width: 100%;
    padding: 0.8em 1.1em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .ted__prepinace {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 0;
  }
  .ted__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 0.95em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    font-size: 0.86rem;
    cursor: pointer;
  }
