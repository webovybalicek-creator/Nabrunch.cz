    font: 600 1rem/1.3 var(--f-display);
  }
  .ted__seznam :global(.tk__adr) {
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .ted__seznam :global(.tk__stav) {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .ted__seznam :global(.tk__stav[data-stav='open']) {
    color: var(--green);
  }
  .ted__seznam :global(.tk__stav[data-stav='closed']) {
    color: var(--ink-soft);
  }
  .ted__seznam :global(.tk__stitek) {
    align-self: flex-start;
