  .ted__vysledky[hidden] {
    display: none;
  }
  .ted__seznam {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0.75rem;
  }
  .ted__seznam :global(.tk a) {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    height: 100%;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .ted__seznam :global(.tk--tip a) {
    border-color: var(--accent);
    background: var(--blush);
  }
  .ted__seznam :global(.tk a:hover) {
    border-color: var(--accent);
    box-shadow: 0 6px 20px rgb(83 42 25 / 0.08);
  }
