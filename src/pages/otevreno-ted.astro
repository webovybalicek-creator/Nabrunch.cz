    .ted__chip {
      font-size: 0.8rem;
      padding: 0.35em 0.8em;
    }
    .ted__mesto {
      flex: 1 1 100%;
    }
  }
  .ted__chip input {
    accent-color: var(--green);
  }
  .ted__info {
    min-height: 1.4em;
    margin: 1rem 0;
